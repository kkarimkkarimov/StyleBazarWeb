@model WishlistIndexViewModel
@{
    ViewData["Title"] = "Wishlist";
}

<header class="sb-shop__header">
    <span class="sb-eyebrow">StyleBazar</span>
    <h1>Wishlist</h1>
    <p>Bəyəndiyin məhsulları burada saxla — istədiyin vaxt qayıt.</p>
</header>

@if (!Model.HasItems)
{
    <div class="sb-wishlist-empty">
        <div class="sb-wishlist-empty__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5">
                <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>
            </svg>
        </div>
        <h2>Wishlist boşdur</h2>
        <p>Bəyəndiyin məhsulun üzərindəki ❤ ikonuna toxun — burada saxlanılacaq.</p>
        <a asp-controller="Shop" asp-action="Index" class="sb-btn-primary">
            <span>Mağazaya keç</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
    </div>
}
else
{
    <div class="sb-wishlist-toolbar">
        <span class="sb-wishlist-toolbar__count">
            <strong>@Model.Items.Count</strong> məhsul
        </span>
    </div>

    <div class="sb-wishlist-grid">
        @foreach (var item in Model.Items)
        {
            var hasDiscount = item.DiscountPrice.HasValue && item.DiscountPrice.Value < item.Price;
            <article class="sb-wishlist-card" data-wishlist-card data-product-id="@item.ProductId">
                <a class="sb-wishlist-card__media" asp-controller="Shop" asp-action="Detail" asp-route-id="@item.ProductId" aria-label="@item.ProductName">
                    @if (!string.IsNullOrEmpty(item.MainImageUrl))
                    {
                        <img src="@item.MainImageUrl" alt="@item.ProductName" loading="lazy" />
                    }
                    else
                    {
                        <div class="sb-product__media-fallback">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                        </div>
                    }
                </a>

                <button type="button" class="sb-wishlist-card__remove" data-wishlist-remove data-product-id="@item.ProductId" aria-label="Wishlist-dən sil">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>

                <div class="sb-wishlist-card__body">
                    <h3 class="sb-wishlist-card__name">
                        <a asp-controller="Shop" asp-action="Detail" asp-route-id="@item.ProductId">@item.ProductName</a>
                    </h3>
                    <p class="sb-wishlist-card__store">@item.StoreName</p>
                    <div class="sb-wishlist-card__price">
                        @if (hasDiscount)
                        {
                            <span class="sb-wishlist-card__price-now sb-wishlist-card__price-now--accent">@item.DiscountPrice!.Value.ToString("N2") ₼</span>
                            <span class="sb-wishlist-card__price-old">@item.Price.ToString("N2") ₼</span>
                        }
                        else
                        {
                            <span class="sb-wishlist-card__price-now">@item.Price.ToString("N2") ₼</span>
                        }
                    </div>
                    <a class="sb-wishlist-card__cta" asp-controller="Shop" asp-action="Detail" asp-route-id="@item.ProductId">
                        Məhsula bax
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                    </a>
                </div>

                <span class="sb-wishlist-card__added">@item.AddedAt.ToString("dd MMM yyyy")</span>
            </article>
        }
    </div>
}

@* Anti-forgery token used by the remove buttons (and the heart toggles on the cards) *@
@Html.AntiForgeryToken()
