@model Stylebazar.BLL.DTOs.Cart.CartSummaryDto
@{
    ViewData["Title"] = L["Səbət"].Value;
}

<section class="sb-commerce" data-cart-page>
    <div class="sb-commerce__head">
        <h1 class="sb-commerce__title">@L["Səbətim"]</h1>
        @if (!Model.IsEmpty)
        {
            <span class="sb-commerce__sub"><span data-cart-count>@Model.TotalQuantity</span> @L["məhsul"]</span>
        }
    </div>

    @if (TempData["Error"] is string err)
    {
        <div class="sb-alert sb-alert--err">@err</div>
    }
    @if (TempData["Success"] is string ok)
    {
        <div class="sb-alert sb-alert--ok">@ok</div>
    }

    @Html.AntiForgeryToken()

    <div class="sb-empty" data-cart-empty hidden="@(Model.IsEmpty ? null : "hidden")">
        <div class="sb-empty__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/></svg>
        </div>
        <h2 class="sb-empty__title">@L["Səbətin boşdur"]</h2>
        <p class="sb-empty__text">@L["Bəyəndiyin məhsulları səbətə əlavə et və buradan al."]</p>
        <a asp-controller="Shop" asp-action="Index" class="sb-btn sb-btn--primary">@L["Alış-verişə başla"]</a>
    </div>

    @if (!Model.IsEmpty)
    {
        <div class="sb-buy-grid" data-cart-grid>
            <ul class="sb-cart-items">
                @foreach (var item in Model.Items)
                {
                    <li class="sb-cart-item" data-cart-item data-id="@item.Id">
                        <a class="sb-cart-item__media" asp-controller="Shop" asp-action="Detail" asp-route-slug="@item.ProductSlug">
                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/img/placeholder.svg" : item.ImageUrl)" alt="@item.ProductName" loading="lazy" />
                        </a>
                        <div class="sb-cart-item__body">
                            <a class="sb-cart-item__name" asp-controller="Shop" asp-action="Detail" asp-route-slug="@item.ProductSlug">@item.ProductName</a>
                            <div class="sb-cart-item__meta">
                                @item.StoreName
                                @if (!string.IsNullOrEmpty(item.Size)) { <text> · @L["Ölçü"]: @item.Size</text> }
                                @if (!string.IsNullOrEmpty(item.Color)) { <text> · @L["Rəng"]: @item.Color</text> }
                            </div>
                            <div class="sb-cart-item__unit">@item.UnitPrice.ToString("0.##") ₼</div>
                            @if (item.StockQuantity <= 5)
                            {
                                <div class="sb-cart-item__low">@L["Stokda az qalıb"]: @item.StockQuantity</div>
                            }
                        </div>
                        <div class="sb-cart-item__side">
                            <div class="sb-cart-item__total" data-line-total>@item.LineTotal.ToString("0.##") ₼</div>
                            <div class="sb-stepper" data-qty data-max="@item.StockQuantity">
                                <button type="button" class="sb-stepper__btn" data-qty-dec aria-label="@L["Azalt"]">−</button>
                                <input class="sb-stepper__input" data-qty-input type="number" value="@item.Quantity" min="1" max="@item.StockQuantity" aria-label="@L["Say"]" />
                                <button type="button" class="sb-stepper__btn" data-qty-inc aria-label="@L["Artır"]">+</button>
                            </div>
                            <form method="post" asp-action="Remove">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="sb-cart-item__remove" data-remove aria-label="@L["Sil"]">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6M14 11v6"/></svg>
                                    @L["Sil"]
                                </button>
                            </form>
                        </div>
                    </li>
                }
            </ul>

            <aside class="sb-summary">
                <h2 class="sb-summary__title">@L["Sifariş xülasəsi"]</h2>
                <div class="sb-summary__row">
                    <span>@L["Cəmi"] (<span data-cart-count>@Model.TotalQuantity</span> @L["məhsul"])</span>
                    <strong data-subtotal>@Model.Subtotal.ToString("0.##") ₼</strong>
                </div>
                <div class="sb-summary__row sb-summary__row--muted">
                    <span>@L["Çatdırılma"]</span>
                    <span class="sb-summary__free">@L["Pulsuz"]</span>
                </div>
                <a asp-controller="Checkout" asp-action="Index" class="sb-btn sb-btn--primary sb-btn--block">@L["Ödənişə keç"]</a>
                <a asp-controller="Shop" asp-action="Index" class="sb-btn sb-btn--ghost sb-btn--block">@L["Alış-verişə davam et"]</a>
            </aside>
        </div>
    }
</section>
