@model CartIndexViewModel
@{
    ViewData["Title"] = "Səbət";
    var cart = Model.Cart;
}

<header class="sb-shop__header">
    <span class="sb-eyebrow">StyleBazar</span>
    <h1>Səbət</h1>
    <p>Sifariş vermədən öncə məhsulları nəzərdən keçir.</p>
</header>

@if (!cart.Items.Any())
{
    <div class="sb-cart-empty">
        <div class="sb-cart-empty__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5">
                <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
            </svg>
        </div>
        <h2>Səbət boşdur</h2>
        <p>Bəyəndiyin məhsulu seçib səbətə əlavə et — burada görəcəksən.</p>
        <a asp-controller="Shop" asp-action="Index" class="sb-btn-primary">
            <span>Mağazaya keç</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
    </div>
}
else
{
    <div class="sb-cart-layout">

        @* ============== LEFT — items list ============== *@
        <section class="sb-cart-items" id="sbCartItems">
            <header class="sb-cart-items__head">
                <h2>@cart.TotalItemCount məhsul</h2>
                <button type="button" class="sb-btn-ghost sb-btn-ghost--sm" data-cart-clear>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/></svg>
                    Səbəti təmizlə
                </button>
            </header>

            @if (cart.HasIssues)
            {
                <div class="sb-cart-alert">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    <span>Bəzi məhsullar dəyişib — qiymət və ya stok yenilənib. Sifariş vermədən öncə yoxla.</span>
                </div>
            }

            <div class="sb-cart-lines">
                @foreach (var line in cart.Items)
                {
                    <article class="sb-cart-line @(line.IsActive ? "" : "is-inactive") @(line.Quantity > line.AvailableStock ? "is-stock-issue" : "")" data-cart-line data-item-id="@line.Id">
                        <a class="sb-cart-line__media" asp-controller="Shop" asp-action="Detail" asp-route-id="@line.ProductId">
                            @if (!string.IsNullOrEmpty(line.MainImageUrl))
                            {
                                <img src="@line.MainImageUrl" alt="@line.ProductName" loading="lazy" />
                            }
                            else
                            {
                                <div class="sb-product__media-fallback">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                                </div>
                            }
                        </a>

                        <div class="sb-cart-line__body">
                            <h3 class="sb-cart-line__name">
                                <a asp-controller="Shop" asp-action="Detail" asp-route-id="@line.ProductId">@line.ProductName</a>
                            </h3>
                            <p class="sb-cart-line__store">@line.StoreName</p>
                            @if (!string.IsNullOrEmpty(line.SizeLabel))
                            {
                                <p class="sb-cart-line__meta">Ölçü: <strong>@line.SizeLabel</strong></p>
                            }

                            @if (!line.IsActive)
                            {
                                <p class="sb-cart-line__warn">Bu məhsul artıq satışda deyil</p>
                            }
                            else if (line.Quantity > line.AvailableStock)
                            {
                                <p class="sb-cart-line__warn">Yalnız @line.AvailableStock ədəd qalıb — miqdarı azaldın</p>
                            }
                            else if (line.PriceChanged)
                            {
                                <p class="sb-cart-line__info">Qiymət yeniləndi — yeni qiymət: @line.UnitPriceCurrent.ToString("N2") ₼</p>
                            }
                        </div>

                        <div class="sb-cart-line__qty">
                            <div class="sb-qty sb-qty--sm" data-qty data-cart-qty data-max="@line.AvailableStock">
                                <button type="button" class="sb-qty__btn" data-qty-dec aria-label="Azalt">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                </button>
                                <input type="number" class="sb-qty__input" value="@line.Quantity" min="1" max="@Math.Max(1, line.AvailableStock)" data-qty-input />
                                <button type="button" class="sb-qty__btn" data-qty-inc aria-label="Artır">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                </button>
                            </div>
                        </div>

                        <div class="sb-cart-line__price">
                            <span class="sb-cart-line__unit">@line.UnitPriceCurrent.ToString("N2") ₼</span>
                            <strong class="sb-cart-line__total" data-line-total>@line.LineTotal.ToString("N2") ₼</strong>
                        </div>

                        <button type="button" class="sb-cart-line__remove" data-cart-remove aria-label="Səbətdən sil">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        </button>
                    </article>
                }
            </div>
        </section>

        @* ============== RIGHT — summary card ============== *@
        <aside class="sb-cart-summary">
            <div class="sb-cart-summary__sticky">
                <h3>Sifariş xülasəsi</h3>
                <dl class="sb-cart-summary__lines">
                    <div>
                        <dt>Məhsullar (<span data-summary-count>@cart.TotalItemCount</span>)</dt>
                        <dd data-summary-subtotal>@cart.Subtotal.ToString("N2") ₼</dd>
                    </div>
                    <div>
                        <dt>Çatdırılma</dt>
                        <dd class="sb-cart-summary__muted">Növbəti addımda</dd>
                    </div>
                </dl>
                <div class="sb-cart-summary__total">
                    <span>Cəm</span>
                    <strong data-summary-total>@cart.Subtotal.ToString("N2") ₼</strong>
                </div>
                <a class="sb-btn-primary sb-btn-primary--full" asp-controller="Checkout" asp-action="Index">
                    <span>Sifarişə keç</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>

                <ul class="sb-cart-summary__perks">
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
                        14 gün ərzində geri qaytarma
                    </li>
                    <li>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                        Təhlükəsiz ödəniş
                    </li>
                </ul>
            </div>
        </aside>
    </div>
}
