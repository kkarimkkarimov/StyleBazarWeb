@{
    ViewData["Title"] = "Haqqımızda";
}

<section class="sb-page-hero">
    <span class="sb-eyebrow">Bizim haqqımızda</span>
    <h1>Yerli moda üçün <em style="font-style: italic; color: var(--sb-accent);">tək platforma.</em></h1>
    <p>StyleBazar — Azərbaycanda fəaliyyət göstərən kiçik və orta moda mağazalarına onlayn satış imkanı verən, alıcılara isə yerli brendləri kəşf etmək imkanı yaradan platformadır.</p>
</section>

<section class="sb-section">
    <div class="sb-trust" style="grid-template-columns: 1fr;">
        <div class="sb-trust__item" style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: center; padding: 40px;">
            <div>
                <span class="sb-eyebrow">Missiyamız</span>
                <h2 style="margin-top: 8px;">Hər yerli brendin öz auditoriyasına çıxa bilməsi.</h2>
                <p class="sb-muted">
                    Onlayn ticarət böyük platformaların inhisarındadır. Biz inanırıq ki,
                    yerli kiçik mağazaların da öz hekayəsi və auditoriyası ola bilər —
                    sadəcə doğru alət lazımdır.
                </p>
            </div>
            <div style="background: linear-gradient(135deg, var(--sb-accent), #FF8A6E); border-radius: var(--sb-radius); aspect-ratio: 1; display: flex; align-items: center; justify-content: center; color: #fff;">
                <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M3 9l1-5h16l1 5"/><path d="M5 9v11h14V9"/><path d="M12 4v16"/></svg>
            </div>
        </div>
    </div>
</section>

<section class="sb-section">
    <div class="sb-section-head">
        <div>
            <span class="sb-eyebrow">Rəqəmlərlə</span>
            <h2>StyleBazar bu gün</h2>
        </div>
    </div>
    <div class="sb-trust">
        <div class="sb-trust__item">
            <div style="font-family: var(--sb-font-display); font-size: 3rem; color: var(--sb-accent); line-height: 1; margin-bottom: 8px;">100+</div>
            <h3>Yerli mağaza</h3>
            <p>StyleBazar üzərindən satışa başlayan satıcılar.</p>
        </div>
        <div class="sb-trust__item">
            <div style="font-family: var(--sb-font-display); font-size: 3rem; color: var(--sb-accent); line-height: 1; margin-bottom: 8px;">5K+</div>
            <h3>Məhsul</h3>
            <p>Geyim, ayaqqabı, aksesuar — bir-bir seçilmişdir.</p>
        </div>
        <div class="sb-trust__item">
            <div style="font-family: var(--sb-font-display); font-size: 3rem; color: var(--sb-accent); line-height: 1; margin-bottom: 8px;">98%</div>
            <h3>Məmnun alıcı</h3>
            <p>Şəkilli rəylər və real reytinqlər əsasında.</p>
        </div>
    </div>
</section>

<section class="sb-section">
    <div class="sb-newsletter">
        <span class="sb-eyebrow" style="color: rgba(255,255,255,.6);">Bizimlə qoşul</span>
        <h2>Mağazanı bu gün başlat</h2>
        <p>Qeydiyyatdan keç, 5 dəqiqədə öz mağazanı qur, ilk məhsulunu yüklə.</p>
        <a class="sb-btn sb-btn--accent sb-btn--lg" asp-controller="Account" asp-action="Register">Satıcı kimi qoşul</a>
    </div>
</section>
