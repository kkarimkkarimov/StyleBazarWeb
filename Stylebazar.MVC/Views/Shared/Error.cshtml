@model ErrorViewModel
@{
    int? code = ViewData["StatusCode"] as int?;
    string headline = code switch
    {
        404 => L["Səhifə tapılmadı"].Value,
        403 => L["Giriş qadağandır"].Value,
        401 => L["Giriş tələb olunur"].Value,
        _   => L["Bir səhv baş verdi"].Value
    };
    string badge = code?.ToString() ?? "5×0";
    string subtitle = code switch
    {
        404 => L["Axtardığın səhifə köçürülmüş, silinmiş və ya heç vaxt mövcud olmamış ola bilər."].Value,
        403 => L["Bu səhifəyə icazən yoxdur. Hesabını dəyişməyə cəhd et və ya ana səhifəyə qayıt."].Value,
        401 => L["Bu səhifəyə baxmaq üçün hesabına daxil olmalısan."].Value,
        _   => L["Sorğu emal olunarkən gözlənilməz problem yarandı. Səhifəni yeniləyə və ya ana səhifəyə qayıda bilərsən."].Value
    };
    ViewData["Title"] = headline;
}

<section class="sb-section" style="max-width: 540px; margin: 80px auto; text-align: center;">
    <div style="font-family: var(--sb-font-display); font-size: 5rem; line-height: 1; color: var(--sb-accent); margin-bottom: 8px;">@badge</div>
    <h1>@headline</h1>
    <p class="sb-muted" style="font-size: 1.05rem;">
        @subtitle
    </p>
    @if (Model.ShowRequestId)
    {
        <p style="font-size: .8rem; color: var(--sb-muted); margin-top: 24px;">
            Request ID: <code>@Model.RequestId</code>
        </p>
    }
    <div style="margin-top: 32px; display: flex; gap: 12px; justify-content: center;">
        <a class="sb-btn sb-btn--primary" asp-controller="Home" asp-action="Index">@L["Ana səhifə"]</a>
        <a class="sb-btn sb-btn--ghost" asp-controller="Shop" asp-action="Index">@L["Mağazaya bax"]</a>
    </div>
</section>
