@model ErrorViewModel
@{
    ViewData["Title"] = "Xəta";
}

<div class="sb-card p-4 p-md-5 text-center">
    <i class="bi bi-exclamation-triangle fs-1 text-danger mb-3"></i>
    <h1 class="fw-700">Bir səhv baş verdi</h1>
    <p class="text-muted-2">
        Sorğu emal olunarkən gözlənilməz problem yarandı. Səhifəni yeniləyib təkrar cəhd edə bilərsən.
    </p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted-2">
            Request ID: <code>@Model.RequestId</code>
        </p>
    }
    <a class="btn btn-primary mt-2" asp-controller="Home" asp-action="Index">
        <i class="bi bi-house me-1"></i> Ana səhifəyə qayıt
    </a>
</div>
