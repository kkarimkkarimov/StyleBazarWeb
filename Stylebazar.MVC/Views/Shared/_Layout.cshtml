@using Microsoft.AspNetCore.Identity
@using Stylebazar.BLL.Services.Cart
@using Stylebazar.BLL.Services.Wishlist
@using Stylebazar.DAL.Entities
@inject SignInManager<AppUser> SignInManager
@inject IWishlistService WishlistService
@inject ICartService CartService
@{
    // Header counter badges — only ping the DB when the user is signed in.
    // Anonymous => zero, no query.
    int wishlistCount = 0;
    int cartCount = 0;
    if (SignInManager.IsSignedIn(User))
    {
        wishlistCount = await WishlistService.GetMyCountAsync(Context.RequestAborted);
        cartCount = await CartService.GetMyCountAsync(Context.RequestAborted);
    }
}
<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#FFFFFF" />
    <title>@(ViewData["Title"]) — StyleBazar</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-auth="@(SignInManager.IsSignedIn(User) ? "true" : "false")">
    @* Global anti-forgery token — used by every AJAX endpoint (wishlist toggle,
       review form, etc.) so we don't have to render it per-page. *@
    @Html.AntiForgeryToken()
    @* ============== TOP UTILITY BAR (desktop only) ============== *@
    <div class="sb-utility">
        <div class="sb-container sb-utility__bar">
            <a asp-controller="Account" asp-action="Register">Satıcı kimi qoşul</a>
            <span class="sb-utility__divider"></span>
            <a asp-controller="Support" asp-action="Index">Dəstək</a>
            <span class="sb-utility__divider"></span>
            <div class="sb-lang">
                <button class="sb-lang__toggle" type="button" id="sbLangToggle" aria-haspopup="true" aria-expanded="false">
                    <span class="sb-lang__flag sb-lang__flag--az" aria-hidden="true"></span>
                    <span>AZ</span>
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <div class="sb-lang__menu" id="sbLangMenu" role="menu">
                    <button type="button" class="is-active" data-lang="az"><span class="sb-lang__flag sb-lang__flag--az"></span>Azərbaycan</button>
                    <button type="button" data-lang="en"><span class="sb-lang__flag sb-lang__flag--en"></span>English</button>
                    <button type="button" data-lang="ru"><span class="sb-lang__flag sb-lang__flag--ru"></span>Русский</button>
                </div>
            </div>
        </div>
    </div>

    @* ============== HEADER ============== *@
    <header class="sb-header" id="sbHeader">
        <div class="sb-container sb-header__bar">
            <a class="sb-brand" asp-controller="Home" asp-action="Index">
                StyleBazar<span class="sb-brand__dot">.</span>
            </a>

            <ul class="sb-nav">
                <li class="sb-nav__item">
                    <a class="sb-nav__link" asp-controller="Shop" asp-action="Index">Mağaza</a>
                </li>
                <li class="sb-nav__item">
                    <a class="sb-nav__link" asp-controller="Store" asp-action="Index">Satıcılar</a>
                </li>
                <li class="sb-nav__item" data-mega="categories">
                    <button class="sb-nav__link" type="button" aria-haspopup="true" aria-expanded="false">
                        Kateqoriyalar
                        <svg class="sb-nav__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="6 9 12 15 18 9"/></svg>
                    </button>
                    <div class="sb-mega" role="menu" aria-label="Kateqoriyalar">
                        <div class="sb-mega__grid">
                            <div class="sb-mega__col">
                                <h5>İnsanlar</h5>
                                <a class="sb-mega__cell" asp-controller="Shop" asp-action="Index" asp-route-search="qadin">
                                    <span class="sb-mega__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="4.5" r="2.5"/><path d="M9 8l-2 4h10l-2-4"/><path d="M7 12l-2 9h14l-2-9"/></svg></span>
                                    <span class="sb-mega__cell-text">
                                        <span class="sb-mega__cell-title">Qadın</span>
                                        <span class="sb-mega__cell-sub">Yeni mövsüm geyimləri</span>
                                    </span>
                                </a>
                                <a class="sb-mega__cell" asp-controller="Shop" asp-action="Index" asp-route-search="kisi">
                                    <span class="sb-mega__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="4.5" r="2.5"/><path d="M7 9l-1 12h12l-1-12"/><path d="M12 9v12"/></svg></span>
                                    <span class="sb-mega__cell-text">
                                        <span class="sb-mega__cell-title">Kişi</span>
                                        <span class="sb-mega__cell-sub">Klassik və idman</span>
                                    </span>
                                </a>
                                <a class="sb-mega__cell" asp-controller="Shop" asp-action="Index" asp-route-search="usaq">
                                    <span class="sb-mega__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="6" r="2"/><path d="M8 12h8"/><path d="M9 12l-1 9h8l-1-9"/></svg></span>
                                    <span class="sb-mega__cell-text">
                                        <span class="sb-mega__cell-title">Uşaq</span>
                                        <span class="sb-mega__cell-sub">0–12 yaş</span>
                                    </span>
                                </a>
                            </div>
                            <div class="sb-mega__col">
                                <h5>Geyim</h5>
                                <a class="sb-mega__cell" asp-controller="Shop" asp-action="Index" asp-route-search="ust-geyim">
                                    <span class="sb-mega__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M9 3l3 2 3-2"/><path d="M9 3L4 6l2 4v11h12V10l2-4-5-3"/></svg></span>
                                    <span class="sb-mega__cell-text">
                                        <span class="sb-mega__cell-title">Üst geyim</span>
                                        <span class="sb-mega__cell-sub">Köynək, jaket, palto</span>
                                    </span>
                                </a>
                                <a class="sb-mega__cell" asp-controller="Shop" asp-action="Index" asp-route-search="alt-geyim">
                                    <span class="sb-mega__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M8 3h8l-1 8-2 10h-2l-1-9-1 9H7L6 11z"/></svg></span>
                                    <span class="sb-mega__cell-text">
                                        <span class="sb-mega__cell-title">Alt geyim</span>
                                        <span class="sb-mega__cell-sub">Şalvar, ətək</span>
                                    </span>
                                </a>
                                <a class="sb-mega__cell" asp-controller="Shop" asp-action="Index" asp-route-search="ayaqqabi">
                                    <span class="sb-mega__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M3 17c0-1 0-5 2-7l5-4 3 3 5 2c2 1 3 2 3 4v3H3z"/><path d="M3 17v2h18v-2"/></svg></span>
                                    <span class="sb-mega__cell-text">
                                        <span class="sb-mega__cell-title">Ayaqqabı</span>
                                        <span class="sb-mega__cell-sub">Hər mövsüm</span>
                                    </span>
                                </a>
                            </div>
                            <div class="sb-mega__col">
                                <h5>Aksesuar</h5>
                                <a class="sb-mega__cell" asp-controller="Shop" asp-action="Index" asp-route-search="canta">
                                    <span class="sb-mega__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M4 8h16l-1 13H5z"/><path d="M8 8V6a4 4 0 018 0v2"/><circle cx="9" cy="14" r=".5" fill="currentColor"/><circle cx="15" cy="14" r=".5" fill="currentColor"/></svg></span>
                                    <span class="sb-mega__cell-text">
                                        <span class="sb-mega__cell-title">Çanta</span>
                                        <span class="sb-mega__cell-sub">Hər stilə uyğun</span>
                                    </span>
                                </a>
                                <a class="sb-mega__cell" asp-controller="Shop" asp-action="Index" asp-route-search="bijuteriya">
                                    <span class="sb-mega__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="14" r="6"/><path d="M8 8l4-5 4 5"/><path d="M9 14h6"/></svg></span>
                                    <span class="sb-mega__cell-text">
                                        <span class="sb-mega__cell-title">Bijuteriya</span>
                                        <span class="sb-mega__cell-sub">Üzük, qolbaq, sancaq</span>
                                    </span>
                                </a>
                                <a class="sb-mega__cell" asp-controller="Shop" asp-action="Index" asp-route-search="kosmetika">
                                    <span class="sb-mega__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="9" y="3" width="6" height="5" rx="1"/><path d="M10 8h4l-1 4h-2z"/><rect x="9" y="12" width="6" height="9" rx="1"/></svg></span>
                                    <span class="sb-mega__cell-text">
                                        <span class="sb-mega__cell-title">Kosmetika</span>
                                        <span class="sb-mega__cell-sub">Üz, dodaq, ətir</span>
                                    </span>
                                </a>
                            </div>
                            <a class="sb-mega__featured" asp-controller="Shop" asp-action="Index" asp-route-isFeatured="true">
                                <h6>Yeni kolleksiya</h6>
                                <p>Bu mövsümün ən populyar parçaları, yerli satıcılardan.</p>
                                <span class="sb-mega__featured-cta">Kəşf et →</span>
                            </a>
                        </div>
                    </div>
                </li>
                <li class="sb-nav__item" data-mega="blog">
                    <button class="sb-nav__link" type="button" aria-haspopup="true" aria-expanded="false">
                        Blog
                        <svg class="sb-nav__chev" viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="6 9 12 15 18 9"/></svg>
                    </button>
                    <div class="sb-mega sb-mega--blog" role="menu" aria-label="Blog">
                        <div class="sb-mega__grid">
                            <div class="sb-mega__col">
                                <h5>Yeni</h5>
                                <a class="sb-mega__cell" asp-controller="Blog" asp-action="Index">
                                    <span class="sb-mega__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="4" width="18" height="16" rx="2"/><line x1="7" y1="9" x2="17" y2="9"/><line x1="7" y1="13" x2="17" y2="13"/><line x1="7" y1="17" x2="13" y2="17"/></svg></span>
                                    <span class="sb-mega__cell-text">
                                        <span class="sb-mega__cell-title">Hamısı</span>
                                        <span class="sb-mega__cell-sub">Bütün yazılar</span>
                                    </span>
                                </a>
                                <a class="sb-mega__cell" asp-controller="Blog" asp-action="Index" asp-route-cat="moda">
                                    <span class="sb-mega__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 2l3 7h7l-5.5 4 2 7L12 16l-6.5 4 2-7L2 9h7z"/></svg></span>
                                    <span class="sb-mega__cell-text">
                                        <span class="sb-mega__cell-title">Moda</span>
                                        <span class="sb-mega__cell-sub">Trend və üslublar</span>
                                    </span>
                                </a>
                            </div>
                            <div class="sb-mega__col">
                                <h5>Bələdçi</h5>
                                <a class="sb-mega__cell" asp-controller="Blog" asp-action="Index" asp-route-cat="rehberler">
                                    <span class="sb-mega__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg></span>
                                    <span class="sb-mega__cell-text">
                                        <span class="sb-mega__cell-title">Geyim rəhbərləri</span>
                                        <span class="sb-mega__cell-sub">Necə kombin etmək</span>
                                    </span>
                                </a>
                                <a class="sb-mega__cell" asp-controller="Blog" asp-action="Index" asp-route-cat="meslehetler">
                                    <span class="sb-mega__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="3"/><path d="M12 5v2"/><path d="M12 17v2"/><path d="M5 12h2"/><path d="M17 12h2"/><path d="M7 7l1.5 1.5"/><path d="M15.5 15.5l1.5 1.5"/><path d="M7 17l1.5-1.5"/><path d="M15.5 8.5l1.5-1.5"/></svg></span>
                                    <span class="sb-mega__cell-text">
                                        <span class="sb-mega__cell-title">Alış məsləhətləri</span>
                                        <span class="sb-mega__cell-sub">Daha yaxşı seç</span>
                                    </span>
                                </a>
                            </div>
                            <div class="sb-mega__col">
                                <h5>Biznes</h5>
                                <a class="sb-mega__cell" asp-controller="Blog" asp-action="Index" asp-route-cat="eticaret">
                                    <span class="sb-mega__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="3 17 9 11 13 15 21 7"/><polyline points="14 7 21 7 21 14"/></svg></span>
                                    <span class="sb-mega__cell-text">
                                        <span class="sb-mega__cell-title">E-Ticarət</span>
                                        <span class="sb-mega__cell-sub">Satıcı uğur hekayələri</span>
                                    </span>
                                </a>
                                <a class="sb-mega__cell" asp-controller="Blog" asp-action="Index" asp-route-cat="brendler">
                                    <span class="sb-mega__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 2l9 5v10l-9 5-9-5V7z"/><path d="M3.27 6.96L12 12.01l8.73-5.05"/><path d="M12 22V12"/></svg></span>
                                    <span class="sb-mega__cell-text">
                                        <span class="sb-mega__cell-title">Brand hekayələri</span>
                                        <span class="sb-mega__cell-sub">Yerli markalar</span>
                                    </span>
                                </a>
                            </div>
                            <a class="sb-mega__featured" asp-controller="Blog" asp-action="Index">
                                <h6>Editor's Pick</h6>
                                <p>Bu həftənin ən çox oxunan moda yazısı.</p>
                                <span class="sb-mega__featured-cta">Oxu →</span>
                            </a>
                        </div>
                    </div>
                </li>
                <li class="sb-nav__item">
                    <a class="sb-nav__link" asp-controller="About" asp-action="Index">Haqqımızda</a>
                </li>
            </ul>

            <div class="sb-header__spacer"></div>

            <div class="sb-header__actions">
                <button class="sb-icon-btn" type="button" id="sbSearchOpen" aria-label="Axtarış">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                </button>

                @if (SignInManager.IsSignedIn(User))
                {
                    <a class="sb-icon-btn sb-icon-btn--counter" asp-controller="Wishlist" asp-action="Index" aria-label="Wishlist" data-wishlist-link>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
                        <span class="sb-icon-btn__count @(wishlistCount > 0 ? "is-visible" : "")" data-wishlist-count>@wishlistCount</span>
                    </a>
                    <button class="sb-icon-btn sb-icon-btn--counter" type="button" aria-label="Səbət" data-cart-open>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/></svg>
                        <span class="sb-icon-btn__count @(cartCount > 0 ? "is-visible" : "")" data-cart-count>@cartCount</span>
                    </button>
                }
                else
                {
                    <button class="sb-icon-btn sb-icon-btn--counter" type="button" aria-label="Səbət" data-cart-open>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/></svg>
                        <span class="sb-icon-btn__count" data-cart-count>0</span>
                    </button>
                }
                @if (SignInManager.IsSignedIn(User))
                {
                    <div class="sb-user-wrap">
                        <button class="sb-user" type="button" id="sbUserToggle" aria-haspopup="true" aria-expanded="false">
                            <span class="sb-user__avatar">@(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")</span>
                            <span>@(User.Identity?.Name?.Split('@')[0] ?? "Hesab")</span>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="6 9 12 15 18 9"/></svg>
                        </button>
                        <div class="sb-dropdown" id="sbUserMenu" role="menu">
                            <a class="sb-dropdown__item" asp-controller="Account" asp-action="Profile">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                Profil
                            </a>
                            <a class="sb-dropdown__item" asp-controller="Wishlist" asp-action="Index">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
                                Wishlist
                            </a>
                            <a class="sb-dropdown__item" asp-controller="Order" asp-action="History">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                                Sifarişlərim
                            </a>
                            <a class="sb-dropdown__item" asp-controller="Address" asp-action="Addresses">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                Ünvanlarım
                            </a>
                            @if (User.IsInRole("Seller"))
                            {
                                <a class="sb-dropdown__item" asp-area="Seller" asp-controller="Store" asp-action="Index">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 9l1-5h16l1 5"/><path d="M5 9v11h14V9"/></svg>
                                    Satıcı paneli
                                </a>
                            }
                            @if (User.IsInRole("Admin"))
                            {
                                <a class="sb-dropdown__item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                    Admin
                                </a>
                            }
                            <div class="sb-dropdown__sep"></div>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="sb-dropdown__item sb-dropdown__item--danger">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                                    Çıxış
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <div class="sb-auth-actions">
                        <a class="sb-btn sb-btn--ghost sb-btn--sm" asp-controller="Account" asp-action="Login">Giriş</a>
                        <a class="sb-btn sb-btn--primary sb-btn--sm" asp-controller="Account" asp-action="Register">Qeydiyyat</a>
                    </div>
                }

                <button class="sb-icon-btn sb-burger" type="button" id="sbBurger" aria-label="Menyu">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
                </button>
            </div>
        </div>
    </header>

    @* ============== MEGA-MENU BACKDROP ============== *@
    <div class="sb-mega-backdrop" id="sbMegaBackdrop" aria-hidden="true"></div>

    @* ============== SEARCH OVERLAY ============== *@
    <div class="sb-search-overlay" id="sbSearchOverlay" aria-hidden="true">
        <div class="sb-container">
            <div class="sb-search-overlay__head">
                <form class="sb-search-overlay__form" asp-controller="Shop" asp-action="Index" method="get" role="search">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    <input class="sb-search-overlay__input" type="search" name="search" placeholder="Nə axtarırsan?" id="sbSearchInput" autocomplete="off" />
                </form>
                <button class="sb-icon-btn" type="button" id="sbSearchClose" aria-label="Bağla">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>

            <div class="sb-search-overlay__suggestions">
                <div>
                    <div class="sb-search-overlay__suggestion-label">Populyar axtarışlar</div>
                    <div class="sb-search-overlay__chips">
                        <a class="sb-search-overlay__chip" asp-controller="Shop" asp-action="Index" asp-route-search="köynək">Köynək</a>
                        <a class="sb-search-overlay__chip" asp-controller="Shop" asp-action="Index" asp-route-search="ayaqqabı">Ayaqqabı</a>
                        <a class="sb-search-overlay__chip" asp-controller="Shop" asp-action="Index" asp-route-search="çanta">Çanta</a>
                        <a class="sb-search-overlay__chip" asp-controller="Shop" asp-action="Index" asp-route-search="palto">Palto</a>
                        <a class="sb-search-overlay__chip" asp-controller="Shop" asp-action="Index" asp-route-search="şalvar">Şalvar</a>
                    </div>
                </div>
                <div style="margin-top: 24px;">
                    <div class="sb-search-overlay__suggestion-label">Tez keçidlər</div>
                    <div class="sb-search-overlay__chips">
                        <a class="sb-search-overlay__chip" asp-controller="Shop" asp-action="Index" asp-route-isFeatured="true">Yeni gələnlər</a>
                        <a class="sb-search-overlay__chip" asp-controller="Shop" asp-action="Index" asp-route-sortBy="price-asc">Ucuzdan bahaya</a>
                        <a class="sb-search-overlay__chip" asp-controller="Store" asp-action="Index">Bütün satıcılar</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ============== MOBILE MENU ============== *@
    <div class="sb-mobile-menu" id="sbMobileMenu" aria-hidden="true">
        <div class="sb-mobile-menu__head">
            <a class="sb-brand" asp-controller="Home" asp-action="Index">
                StyleBazar<span class="sb-brand__dot">.</span>
            </a>
            <button class="sb-icon-btn" type="button" id="sbMenuClose" aria-label="Bağla">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <ul class="sb-mobile-menu__list">
            <li><a asp-controller="Shop" asp-action="Index">Mağaza <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="9 18 15 12 9 6"/></svg></a></li>
            <li><a asp-controller="Store" asp-action="Index">Satıcılar <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="9 18 15 12 9 6"/></svg></a></li>
            <li>
                <div class="sb-mobile-acc">
                    <button class="sb-mobile-acc__trigger" type="button">
                        Kateqoriyalar
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="6 9 12 15 18 9"/></svg>
                    </button>
                    <div class="sb-mobile-acc__panel">
                        <div class="sb-mobile-acc__panel-inner">
                            <a class="sb-mobile-acc__link" asp-controller="Shop" asp-action="Index" asp-route-search="qadın"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="6" r="3"/><path d="M9 9l-2 12h10l-2-12"/></svg>Qadın</a>
                            <a class="sb-mobile-acc__link" asp-controller="Shop" asp-action="Index" asp-route-search="kişi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="6" r="3"/><path d="M5 21l3-12h8l3 12"/></svg>Kişi</a>
                            <a class="sb-mobile-acc__link" asp-controller="Shop" asp-action="Index" asp-route-search="uşaq"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="7" r="2.5"/><path d="M8 21l1-9h6l1 9"/></svg>Uşaq</a>
                            <a class="sb-mobile-acc__link" asp-controller="Shop" asp-action="Index" asp-route-search="ayaqqabı"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M2 17l6-9 4 2 4-3 6 4v6H2z"/></svg>Ayaqqabı</a>
                            <a class="sb-mobile-acc__link" asp-controller="Shop" asp-action="Index" asp-route-search="çanta"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 8h14l-1 13H6z"/><path d="M9 8V5a3 3 0 016 0v3"/></svg>Çanta</a>
                            <a class="sb-mobile-acc__link" asp-controller="Shop" asp-action="Index" asp-route-search="bijuteriya"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 3l-4 6 10 12L22 9l-4-6z"/></svg>Bijuteriya</a>
                        </div>
                    </div>
                </div>
            </li>
            <li><a asp-controller="Blog" asp-action="Index">Blog <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="9 18 15 12 9 6"/></svg></a></li>
            <li><a asp-controller="About" asp-action="Index">Haqqımızda <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="9 18 15 12 9 6"/></svg></a></li>
            <li><a asp-controller="Support" asp-action="Index">Dəstək <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="9 18 15 12 9 6"/></svg></a></li>
            @if (SignInManager.IsSignedIn(User))
            {
                <li><a asp-controller="Account" asp-action="Profile">Profil <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="9 18 15 12 9 6"/></svg></a></li>
                <li><a asp-controller="Wishlist" asp-action="Index">Wishlist <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="9 18 15 12 9 6"/></svg></a></li>
            }
        </ul>
        @if (!SignInManager.IsSignedIn(User))
        {
            <div class="sb-mobile-menu__cta">
                <a class="sb-btn sb-btn--primary sb-btn--block" asp-controller="Account" asp-action="Register">Qeydiyyatdan keç</a>
                <a class="sb-btn sb-btn--ghost sb-btn--block" asp-controller="Account" asp-action="Login">Giriş et</a>
            </div>
        }
        else
        {
            <form asp-controller="Account" asp-action="Logout" method="post" class="sb-mobile-menu__cta">
                <button type="submit" class="sb-btn sb-btn--ghost sb-btn--block">Çıxış</button>
            </form>
        }
    </div>

    @* ============== MARQUEE STRIP ============== *@
    <div class="sb-marquee">
        <div class="sb-marquee__track">
            <span>Yeni satıcılar üçün ilk ay komissiyasız</span>
            <span>Bütün məhsullar yerli mağazalardan</span>
            <span>Şəkilli rəylər ilə inamla seç</span>
            <span>Wishlist ilə sevimlilərini saxla</span>
            <span>Yeni satıcılar üçün ilk ay komissiyasız</span>
            <span>Bütün məhsullar yerli mağazalardan</span>
        </div>
    </div>

    @* ============== MAIN ============== *@
    <main class="sb-container">
        @if (TempData["Success"] is string s) { <div class="sb-alert sb-alert--success">@s</div> }
        @if (TempData["Error"] is string e)   { <div class="sb-alert sb-alert--error">@e</div>   }

        @RenderBody()
    </main>

    @* ============== FOOTER ============== *@
    <footer class="sb-footer">
        <div class="sb-container">
            <div class="sb-footer__cols">
                <div>
                    <a class="sb-brand" asp-controller="Home" asp-action="Index">
                        StyleBazar<span class="sb-brand__dot">.</span>
                    </a>
                    <p class="sb-muted" style="margin-top: 12px; max-width: 320px;">
                        Yerli satıcılardan brend geyimləri tapdığın və sevimlilərini bir yerdə saxladığın platforma.
                    </p>
                </div>
                <div>
                    <h4>Mağaza</h4>
                    <ul>
                        <li><a asp-controller="Shop" asp-action="Index">Bütün məhsullar</a></li>
                        <li><a asp-controller="Shop" asp-action="Index" asp-route-isFeatured="true">Yeni gələnlər</a></li>
                        <li><a asp-controller="Store" asp-action="Index">Satıcılar</a></li>
                        <li><a asp-controller="Blog" asp-action="Index">Blog</a></li>
                    </ul>
                </div>
                <div>
                    <h4>Şirkət</h4>
                    <ul>
                        <li><a asp-controller="About" asp-action="Index">Haqqımızda</a></li>
                        <li><a asp-controller="Support" asp-action="Index">Dəstək</a></li>
                        <li><a asp-controller="Account" asp-action="Register">Satıcı ol</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Gizlilik</a></li>
                    </ul>
                </div>
                <div>
                    <h4>Əlaqə</h4>
                    <ul>
                        <li>support@@stylebazar.az</li>
                        <li>Bakı, Azərbaycan</li>
                    </ul>
                </div>
            </div>
            <div class="sb-footer__bottom">
                <span>&copy; @DateTime.Now.Year StyleBazar. Bütün hüquqlar qorunur.</span>
                <span>Made with ♡ in Baku</span>
            </div>
        </div>
    </footer>

    @* ============== MOBILE BOTTOM TAB BAR ============== *@
    <nav class="sb-bottombar" aria-label="Əsas naviqasiya">
        <a asp-controller="Home" asp-action="Index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M3 9.5L12 3l9 6.5V21H3z"/><path d="M9 21V12h6v9"/></svg>
            <span>Ana</span>
        </a>
        <a asp-controller="Shop" asp-action="Index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <span>Mağaza</span>
        </a>
        <a asp-controller="Wishlist" asp-action="Index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
            <span>Wishlist</span>
        </a>
        @if (SignInManager.IsSignedIn(User))
        {
            <a asp-controller="Account" asp-action="Profile">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                <span>Hesab</span>
            </a>
        }
        else
        {
            <a asp-controller="Account" asp-action="Login">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                <span>Giriş</span>
            </a>
        }
    </nav>

    @* ============== CART DRAWER (slide-in from right) ============== *@
    <div class="sb-cart-drawer" id="sbCartDrawer" aria-hidden="true" role="dialog" aria-label="Səbət">
        <div class="sb-cart-drawer__backdrop" data-cart-close></div>
        <aside class="sb-cart-drawer__panel" role="document">
            <header class="sb-cart-drawer__head">
                <h3>Səbət</h3>
                <button type="button" class="sb-icon-btn" data-cart-close aria-label="Bağla">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </header>
            <div class="sb-cart-drawer__body" data-cart-drawer-body>
                @* Skeleton; populated by JS on open *@
                <div class="sb-cart-drawer__empty" data-cart-drawer-empty>
                    <div class="sb-cart-empty__icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/></svg>
                    </div>
                    <p>Səbət boşdur</p>
                    <a asp-controller="Shop" asp-action="Index" class="sb-btn-ghost">Mağazaya keç</a>
                </div>
                <div class="sb-cart-drawer__lines" data-cart-drawer-lines hidden></div>
            </div>
            <footer class="sb-cart-drawer__foot" data-cart-drawer-foot hidden>
                <div class="sb-cart-drawer__total">
                    <span>Cəm</span>
                    <strong data-cart-drawer-total>0.00 ₼</strong>
                </div>
                <a asp-controller="Cart" asp-action="Index" class="sb-btn-primary sb-btn-primary--full">
                    <span>Səbətə bax</span>
                </a>
            </footer>
        </aside>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
