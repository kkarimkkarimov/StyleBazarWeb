@model Stylebazar.BLL.DTOs.Account.AccountProfileDto
@{
    string currentAction = (ViewContext.RouteData.Values["action"] as string ?? "").ToLowerInvariant();
    string Active(string a) => currentAction == a.ToLowerInvariant() ? "is-active" : "";
}

<aside class="sb-acc-sidebar">
    <div class="sb-acc-sidebar__avatar-block">
        <div class="sb-acc-sidebar__avatar">
            @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
            {
                <img src="@Model.ProfileImageUrl" alt="@Model.FullName" />
            }
            else
            {
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
            }
        </div>
        <strong class="sb-acc-sidebar__name">@Model.FullName</strong>
        <span class="sb-acc-sidebar__code">Customer ID: #@Model.CustomerCode</span>
    </div>

    <nav class="sb-acc-sidebar__nav" aria-label="Hesab naviqasiyası">
        @if (User.IsInRole("Admin"))
        {
            <a class="sb-acc-sidebar__link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
                Admin Panel
            </a>
        }
        @if (Model.VendorCode != null)
        {
            <a class="sb-acc-sidebar__link" asp-controller="Seller" asp-action="Dashboard">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l1-5h16l1 5"/><path d="M5 9v11h14V9"/></svg>
                Mağazalarım
            </a>
        }
        <a class="sb-acc-sidebar__link @Active("Wishlist")" asp-controller="Wishlist" asp-action="Index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
            My Wishlist
        </a>
        <a class="sb-acc-sidebar__link @Active("Messages")" asp-controller="Account" asp-action="Messages">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
            Mesajlarım
        </a>
        <a class="sb-acc-sidebar__link @Active("Notifications")" asp-controller="Account" asp-action="Notifications">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 00-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
            Notifications
        </a>
        <a class="sb-acc-sidebar__link @Active("Addresses")" asp-controller="Account" asp-action="Addresses">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            Address
        </a>
        <a class="sb-acc-sidebar__link @Active("Profile")" asp-controller="Account" asp-action="Profile">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg>
            Profile
        </a>
        <form asp-controller="Account" asp-action="Logout" method="post" class="sb-acc-sidebar__logout-form">
            <button type="submit" class="sb-acc-sidebar__link sb-acc-sidebar__link--danger">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                Logout
            </button>
        </form>
    </nav>
</aside>
