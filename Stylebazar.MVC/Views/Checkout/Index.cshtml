@model Stylebazar.MVC.Models.CheckoutViewModel
@{
    ViewData["Title"] = L["Ödəniş"].Value;
}

<section class="sb-commerce" data-checkout data-place-url="@Url.Action("Place", "Checkout")">
    <div class="sb-commerce__head">
        <h1 class="sb-commerce__title">@L["Sifarişi tamamla"]</h1>
    </div>

    <div class="sb-alert sb-alert--err" data-checkout-error hidden></div>
    @Html.AntiForgeryToken()

    <div class="sb-buy-grid">
        <div>
            <!-- ÇATDIRILMA ÜNVANI -->
            <div class="sb-panel">
                <h2 class="sb-panel__title">@L["Çatdırılma ünvanı"]</h2>

                @if (Model.Addresses.Any())
                {
                    <div class="sb-addr-list">
                        @foreach (var a in Model.Addresses)
                        {
                            <label class="sb-addr">
                                <input type="radio" name="sbAddr" value="@a.Id" class="sb-addr__radio" @(a.Id == Model.DefaultAddressId ? "checked" : "") />
                                <span>
                                    <span class="sb-addr__name">@a.FullName</span>
                                    @if (a.IsDefault) { <span class="sb-addr__badge">@L["Əsas"]</span> }
                                    <span class="sb-addr__lines">
                                        @a.Phone<br />
                                        @a.City@(string.IsNullOrEmpty(a.District) ? "" : ", " + a.District), @a.AddressLine
                                    </span>
                                </span>
                            </label>
                        }
                        <label class="sb-addr sb-addr--new">
                            <input type="radio" name="sbAddr" value="new" class="sb-addr__radio" />
                            <span>＋ @L["Yeni ünvan əlavə et"]</span>
                        </label>
                    </div>
                }

                <div class="sb-field-grid" data-new-addr hidden="@(Model.Addresses.Any() ? "hidden" : null)">
                    <input id="f_FullName" class="sb-input" placeholder="@L["Ad Soyad"]" autocomplete="name" />
                    <input id="f_Phone" class="sb-input" placeholder="@L["Telefon"]" autocomplete="tel" inputmode="tel" />
                    <input id="f_City" class="sb-input" placeholder="@L["Şəhər"]" autocomplete="address-level2" />
                    <input id="f_District" class="sb-input" placeholder="@L["Rayon"]" autocomplete="address-level3" />
                    <input id="f_AddressLine" class="sb-input sb-input--full" placeholder="@L["Ünvan (küçə, ev, mənzil)"]" autocomplete="street-address" />
                    <input id="f_PostalCode" class="sb-input" placeholder="@L["Poçt indeksi"]" autocomplete="postal-code" />
                    <input id="f_Notes" class="sb-input" placeholder="@L["Qeyd (orientir)"]" />
                    <label class="sb-checkrow">
                        <input type="checkbox" id="f_Save" checked /> @L["Bu ünvanı yadda saxla"]
                    </label>
                </div>
            </div>

            <!-- MƏHSULLAR -->
            <div class="sb-panel">
                <h2 class="sb-panel__title">@L["Məhsullar"] (@Model.Cart.TotalQuantity)</h2>
                @foreach (var item in Model.Cart.Items)
                {
                    <div class="sb-miniline">
                        <img class="sb-miniline__img" src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/img/placeholder.svg" : item.ImageUrl)" alt="@item.ProductName" loading="lazy" />
                        <div class="sb-miniline__body">
                            <div class="sb-miniline__name">@item.ProductName</div>
                            <div class="sb-miniline__meta">
                                @item.Quantity × @item.UnitPrice.ToString("0.##") ₼
                                @if (!string.IsNullOrEmpty(item.Size)) { <text> · @item.Size</text> }
                                @if (!string.IsNullOrEmpty(item.Color)) { <text> · @item.Color</text> }
                            </div>
                        </div>
                        <span class="sb-miniline__price">@item.LineTotal.ToString("0.##") ₼</span>
                    </div>
                }
            </div>
        </div>

        <!-- XÜLASƏ + ÖDƏ -->
        <aside class="sb-summary">
            <h2 class="sb-summary__title">@L["Sifariş xülasəsi"]</h2>
            <div class="sb-summary__row sb-summary__row--muted">
                <span>@L["Ara cəm"]</span>
                <span>@Model.Cart.Subtotal.ToString("0.##") ₼</span>
            </div>
            <div class="sb-summary__row sb-summary__row--muted">
                <span>@L["Çatdırılma"]</span>
                <span class="sb-summary__free">@L["Pulsuz"]</span>
            </div>
            <hr class="sb-summary__hr" />
            <div class="sb-summary__total">
                <span>@L["Cəmi"]</span>
                <b>@Model.Cart.Subtotal.ToString("0.##") ₼</b>
            </div>
            <button type="button" class="sb-btn sb-btn--primary sb-btn--block" data-pay>@L["Kartla ödə"]</button>
            <a asp-controller="Cart" asp-action="Index" class="sb-btn sb-btn--ghost sb-btn--block">@L["Səbətə qayıt"]</a>
            <p class="sb-summary__note">🔒 @L["Ödəniş Stripe ilə təhlükəsiz aparılır"]</p>
        </aside>
    </div>
</section>
