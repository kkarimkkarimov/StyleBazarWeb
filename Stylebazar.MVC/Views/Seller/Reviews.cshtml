@model SellerReviewsPageViewModel
@{
    ViewData["Title"] = "Müştəri rəyləri";

    string Stars(int rating)
    {
        // Returns a 5-position string like "★★★☆☆" — easier on the eyes than
        // 5 individual <svg> for a table-heavy view.
        return new string('★', Math.Clamp(rating, 0, 5)) + new string('☆', 5 - Math.Clamp(rating, 0, 5));
    }
}

<section class="sb-seller-layout">
    @await Html.PartialAsync("_SellerSidebar", Model.Profile)

    <main class="sb-seller-main">
        <header class="sb-acc-section-title">
            <h1>Müştəri rəyləri</h1>
            <p class="sb-acc-section-title__sub">Mağazalarındakı məhsullara yazılan ən son @Model.TotalCount rəy</p>
        </header>

        @* ==== KPI cards ==== *@
        <div class="sb-rev-kpi">
            <div class="sb-rev-kpi__card">
                <span class="sb-rev-kpi__label">Ortalama reytinq</span>
                <strong class="sb-rev-kpi__value">
                    @(Model.TotalCount > 0 ? Model.AverageRating.ToString("0.0") : "—")
                    <span class="sb-rev-kpi__stars" aria-hidden="true">
                        @Stars((int)Math.Round(Model.AverageRating))
                    </span>
                </strong>
            </div>
            <div class="sb-rev-kpi__card">
                <span class="sb-rev-kpi__label">Ümumi rəy</span>
                <strong class="sb-rev-kpi__value">@Model.TotalCount</strong>
            </div>
            <div class="sb-rev-kpi__card sb-rev-kpi__card--ok">
                <span class="sb-rev-kpi__label">5 ulduzlu</span>
                <strong class="sb-rev-kpi__value">@Model.FiveStarCount</strong>
            </div>
            <div class="sb-rev-kpi__card sb-rev-kpi__card--warn">
                <span class="sb-rev-kpi__label">Aşağı reytinq (1–2)</span>
                <strong class="sb-rev-kpi__value">@Model.LowStarCount</strong>
            </div>
        </div>

        @* ==== Filter ==== *@
        <form class="sb-rev-filter" method="get" asp-action="Reviews">
            <label class="sb-rev-filter__label">Filtr:</label>
            <select name="maxRating" onchange="this.form.submit()">
                <option value="" selected="@(Model.MaxRatingFilter == null)">Bütün rəylər</option>
                <option value="2" selected="@(Model.MaxRatingFilter == 2)">≤ 2 ulduz (problemli)</option>
                <option value="3" selected="@(Model.MaxRatingFilter == 3)">≤ 3 ulduz</option>
                <option value="4" selected="@(Model.MaxRatingFilter == 4)">≤ 4 ulduz</option>
            </select>
            @if (Model.MaxRatingFilter.HasValue)
            {
                <a class="sb-rev-filter__clear" asp-action="Reviews">Təmizlə</a>
            }
        </form>

        @* ==== Table ==== *@
        @if (!Model.Reviews.Any())
        {
            <div class="sb-seller-card sb-acc-empty">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                <strong>Hələ rəy yoxdur</strong>
                <p>Müştərilər məhsullarına rəy yazdıqda burada görünəcək.</p>
            </div>
        }
        else
        {
            <div class="sb-rev-table-wrap">
                <table class="sb-rev-table">
                    <thead>
                        <tr>
                            <th>Məhsul</th>
                            <th>Reytinq</th>
                            <th>Rəy</th>
                            <th>Müştəri</th>
                            <th>Tarix</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Reviews)
                        {
                            <tr>
                                <td class="sb-rev-table__product">
                                    <a asp-controller="Shop" asp-action="Detail" asp-route-id="@row.ProductId" target="_blank" rel="noopener">
                                        @if (!string.IsNullOrEmpty(row.ProductImageUrl))
                                        {
                                            <img src="@row.ProductImageUrl" alt="@row.ProductName" loading="lazy" />
                                        }
                                        else
                                        {
                                            <span class="sb-rev-table__thumb-fallback"></span>
                                        }
                                        <div>
                                            <strong>@row.ProductName</strong>
                                            <span class="sb-rev-table__store">@row.StoreName</span>
                                        </div>
                                    </a>
                                </td>
                                <td class="sb-rev-table__rating">
                                    <span class="sb-rev-stars" data-rating="@row.Review.Rating" aria-label="@row.Review.Rating / 5">
                                        @Stars(row.Review.Rating)
                                    </span>
                                </td>
                                <td class="sb-rev-table__comment">
                                    @if (!string.IsNullOrWhiteSpace(row.Review.Comment))
                                    {
                                        <p>@row.Review.Comment</p>
                                    }
                                    else
                                    {
                                        <em class="sb-rev-table__no-comment">— şərh yoxdur —</em>
                                    }
                                </td>
                                <td class="sb-rev-table__user">@(string.IsNullOrEmpty(row.Review.UserFullName) ? "Anonim" : row.Review.UserFullName)</td>
                                <td class="sb-rev-table__date">@row.Review.CreatedDate.ToLocalTime().ToString("dd.MM.yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </main>
</section>
