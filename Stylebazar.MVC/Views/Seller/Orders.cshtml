@using Stylebazar.DAL.Entities.Enums
@model SellerOrdersPageViewModel
@{
    ViewData["Title"] = L["Sifarişlər"].Value;
    var p = Model.Profile;

    (string Cls, string Label) Status(OrderStatus s) => s switch
    {
        OrderStatus.Pending => ("sb-status--pending", L["Ödəniş gözlənilir"].Value),
        OrderStatus.Processing => ("sb-status--processing", L["Hazırlanır"].Value),
        OrderStatus.Shipped => ("sb-status--shipped", L["Göndərilib"].Value),
        OrderStatus.Delivered => ("sb-status--delivered", L["Çatdırılıb"].Value),
        OrderStatus.Cancelled => ("sb-status--cancelled", L["Ləğv edilib"].Value),
        _ => ("sb-status--pending", s.ToString())
    };
}

<section class="sb-seller-layout">
    @await Html.PartialAsync("_SellerSidebar", p)

    <main class="sb-seller-main">
        <header class="sb-prod-page-head">
            <div>
                <h1>@L["Sifarişlər"]</h1>
                <p>@L["Mağazanın məhsullarına gələn sifarişlər — hazırla, göndər, çatdır."]</p>
            </div>
        </header>

        @if (TempData["Success"] is string okMsg)
        {
            <div class="sb-prod-toast sb-prod-toast--ok">@okMsg</div>
        }
        @if (TempData["Error"] is string errMsg)
        {
            <div class="sb-prod-toast sb-prod-toast--err">@errMsg</div>
        }

        @if (!Model.Orders.Any())
        {
            <div class="sb-empty">
                <div class="sb-empty__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 01-8 0"/></svg>
                </div>
                <h2 class="sb-empty__title">@L["Hələ sifariş yoxdur"]</h2>
                <p class="sb-empty__text">@L["Məhsulların satılanda sifarişlər burada görünəcək."]</p>
            </div>
        }
        else
        {
            <div class="sb-orders">
                @foreach (var o in Model.Orders)
                {
                    var st = Status(o.Status);
                    <a class="sb-order-row" asp-action="OrderDetail" asp-route-id="@o.Id">
                        <img class="sb-order-row__media" src="@(string.IsNullOrEmpty(o.FirstImageUrl) ? "/img/placeholder.svg" : o.FirstImageUrl)" alt="" loading="lazy" />
                        <div class="sb-order-row__body">
                            <div class="sb-order-row__id">@L["Sifariş"] #@o.Id</div>
                            <div class="sb-order-row__meta">
                                @if (!string.IsNullOrEmpty(o.BuyerName)) { <text>@o.BuyerName · </text> }
                                @o.CreatedDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @o.ItemCount @L["məhsul"] (@o.TotalQuantity @L["ədəd"])
                            </div>
                        </div>
                        <div class="sb-order-row__side">
                            <span class="sb-status @st.Cls">@st.Label</span>
                            <span class="sb-order-row__total">@o.TotalAmount.ToString("0.##") ₼</span>
                        </div>
                    </a>
                }
            </div>
        }
    </main>
</section>
