@using Stylebazar.DAL.Entities.Enums
@model SellerOrderDetailPageViewModel
@{
    ViewData["Title"] = L["Sifariş"].Value + " #" + Model.Order.Id;
    var p = Model.Profile;
    var o = Model.Order;

    (string Label, string Bg, string Fg) StatusChip(OrderStatus s) => s switch
    {
        OrderStatus.Pending => (L["Ödəniş gözlənilir"].Value, "#fff4e5", "#b26a00"),
        OrderStatus.Processing => (L["Hazırlanır"].Value, "#e7f0ff", "#1b5fbf"),
        OrderStatus.Shipped => (L["Göndərilib"].Value, "#efe7ff", "#6b34c4"),
        OrderStatus.Delivered => (L["Çatdırılıb"].Value, "#e6f7ec", "#1e8449"),
        OrderStatus.Cancelled => (L["Ləğv edilib"].Value, "#fdecea", "#a93226"),
        _ => (s.ToString(), "#eee", "#555")
    };
    var chip = StatusChip(o.Status);
}

<section class="sb-seller-layout">
    @await Html.PartialAsync("_SellerSidebar", p)

    <main class="sb-seller-main">
        <a asp-action="Orders" style="color:#888; text-decoration:none; font-size:.9rem;">← @L["Sifarişlərə qayıt"]</a>
        <header class="sb-prod-page-head" style="margin-top:8px;">
            <div>
                <h1>@L["Sifariş"] #@o.Id</h1>
                <p>@o.CreatedDate.ToLocalTime().ToString("dd MMMM yyyy, HH:mm")</p>
            </div>
            <span style="font-size:.8rem; padding:6px 14px; border-radius:20px; background:@chip.Bg; color:@chip.Fg; font-weight:600; align-self:center;">@chip.Label</span>
        </header>

        @if (TempData["Success"] is string okMsg)
        {
            <div class="sb-prod-toast sb-prod-toast--ok">@okMsg</div>
        }
        @if (TempData["Error"] is string errMsg)
        {
            <div class="sb-prod-toast sb-prod-toast--err">@errMsg</div>
        }

        <div style="display:grid; grid-template-columns:1fr 300px; gap:18px; align-items:start;" class="sb-order-grid">
            <!-- MƏHSULLAR (yalnız bu satıcının) -->
            <div class="sb-seller-card">
                <h3 style="margin-top:0;">@L["Məhsullar"]</h3>
                @foreach (var item in o.Items)
                {
                    <div style="display:flex; gap:12px; padding:10px 0; border-bottom:1px solid #f2f2f2;">
                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/img/placeholder.svg" : item.ImageUrl)" alt="@item.ProductName"
                             style="width:58px; height:58px; object-fit:cover; border-radius:8px;" />
                        <div style="flex:1;">
                            <div style="font-weight:600;">@item.ProductName</div>
                            <div style="color:#888; font-size:.82rem; margin-top:2px;">
                                @item.Quantity × @item.UnitPrice.ToString("0.##") ₼
                                @if (!string.IsNullOrEmpty(item.Size)) { <text> · @L["Ölçü"]: @item.Size</text> }
                                @if (!string.IsNullOrEmpty(item.Color)) { <text> · @L["Rəng"]: @item.Color</text> }
                            </div>
                        </div>
                        <strong>@item.LineTotal.ToString("0.##") ₼</strong>
                    </div>
                }
                <div style="display:flex; justify-content:space-between; padding-top:14px; font-size:1.1rem; font-weight:700;">
                    <span>@L["Cəmi"]</span>
                    <span>@o.TotalAmount.ToString("0.##") ₼</span>
                </div>
            </div>

            <div style="display:flex; flex-direction:column; gap:18px;">
                <!-- ÇATDIRILMA ÜNVANI -->
                <aside class="sb-seller-card">
                    <h3 style="margin-top:0;">@L["Çatdırılma ünvanı"]</h3>
                    <p style="margin:6px 0; line-height:1.6;">
                        <strong>@o.ShipFullName</strong><br />
                        @o.ShipPhone<br />
                        @o.ShipCity@(string.IsNullOrEmpty(o.ShipDistrict) ? "" : ", " + o.ShipDistrict)<br />
                        @o.ShipAddressLine
                        @if (!string.IsNullOrEmpty(o.ShipPostalCode)) { <br /><text>@o.ShipPostalCode</text> }
                    </p>
                    @if (!string.IsNullOrEmpty(o.ShipNotes))
                    {
                        <p style="color:#888; font-size:.85rem; margin-top:8px;">@L["Qeyd"]: @o.ShipNotes</p>
                    }
                </aside>

                <!-- STATUS İDARƏETMƏ -->
                <aside class="sb-seller-card">
                    <h3 style="margin-top:0;">@L["Statusu yenilə"]</h3>
                    @if (!o.IsPaid)
                    {
                        <p style="color:#b26a00;">@L["Sifariş hələ ödənilməyib."]</p>
                    }
                    else if (o.Status == OrderStatus.Processing)
                    {
                        <form asp-action="UpdateOrderStatus" method="post" style="margin-bottom:8px;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@o.Id" />
                            <input type="hidden" name="status" value="@((int)OrderStatus.Shipped)" />
                            <button type="submit" class="sb-btn-primary sb-btn-primary--cyan" style="width:100%;">@L["Göndərildi olaraq işarələ"]</button>
                        </form>
                        <form asp-action="UpdateOrderStatus" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@o.Id" />
                            <input type="hidden" name="status" value="@((int)OrderStatus.Cancelled)" />
                            <button type="submit" class="sb-btn sb-btn--ghost" style="width:100%; color:#c0392b;">@L["Sifarişi ləğv et"]</button>
                        </form>
                    }
                    else if (o.Status == OrderStatus.Shipped)
                    {
                        <form asp-action="UpdateOrderStatus" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@o.Id" />
                            <input type="hidden" name="status" value="@((int)OrderStatus.Delivered)" />
                            <button type="submit" class="sb-btn-primary sb-btn-primary--cyan" style="width:100%;">@L["Çatdırıldı olaraq işarələ"]</button>
                        </form>
                    }
                    else if (o.Status == OrderStatus.Delivered)
                    {
                        <p style="color:#1e8449; font-weight:600;">@L["Sifariş çatdırıldı. ✓"]</p>
                    }
                    else if (o.Status == OrderStatus.Cancelled)
                    {
                        <p style="color:#a93226; font-weight:600;">@L["Sifariş ləğv edildi."]</p>
                    }
                </aside>
            </div>
        </div>
    </main>
</section>
