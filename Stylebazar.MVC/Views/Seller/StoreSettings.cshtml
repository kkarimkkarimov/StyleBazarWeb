@model SellerStoreSettingsViewModel
@{
    ViewData["Title"] = L["Mağaza ayarları"].Value;
    var p = Model.Profile;
    var st = Model.Store!;
    var f = Model.Form;
}

<section class="sb-seller-layout">
    @await Html.PartialAsync("_SellerSidebar", p)

    <main class="sb-seller-main">
        <nav class="sb-breadcrumb sb-acc-breadcrumb" aria-label="Breadcrumb">
            <a asp-action="Dashboard">@L["Satıcı paneli"]</a>
            <span class="sb-breadcrumb__sep" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="9 18 15 12 9 6"/></svg>
            </span>
            <span class="sb-breadcrumb__current">@L["Mağaza ayarları"]</span>
        </nav>

        @if (TempData["Success"] is string okMsg)
        {
            <div class="sb-prod-toast sb-prod-toast--ok">@okMsg</div>
        }
        @if (TempData["Error"] is string errMsg)
        {
            <div class="sb-prod-toast sb-prod-toast--err">@errMsg</div>
        }

        @* ============== COVER + AVATAR + STATUS (banner card) ============== *@
        <div class="sb-store-banner-card" data-store-id="@st.Id">
            <div class="sb-store-cover @(string.IsNullOrEmpty(st.CoverImageUrl) ? "is-empty" : "")"
                 data-store-cover>
                @if (!string.IsNullOrEmpty(st.CoverImageUrl))
                {
                    <img src="@st.CoverImageUrl" alt="@st.Name cover" data-store-cover-img />
                }
                else
                {
                    <div class="sb-store-cover__placeholder" data-store-cover-placeholder>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                        <span>@L["Mağaza banneri yoxdur"]</span>
                    </div>
                }

                <div class="sb-store-cover__actions">
                    <label class="sb-store-cover__btn" title="@L["Banner dəyiş"]">
                        <input type="file" accept="image/*" hidden data-store-cover-input />
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                        <span>@L["Banner dəyiş"]</span>
                    </label>
                    <button type="button"
                            class="sb-store-cover__btn sb-store-cover__btn--danger"
                            data-store-cover-remove
                            @(string.IsNullOrEmpty(st.CoverImageUrl) ? "hidden" : "")
                            title="@L["Banner sil"]">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/></svg>
                    </button>
                </div>
            </div>

            <div class="sb-store-banner-card__body">
                <label class="sb-store-avatar" data-store-avatar>
                    <input type="file" accept="image/*" hidden data-store-avatar-input />
                    <span class="sb-store-avatar__img" data-store-avatar-preview>
                        @if (!string.IsNullOrEmpty(st.ProfileImageUrl))
                        {
                            <img src="@st.ProfileImageUrl" alt="@st.Name logo" />
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l1-5h16l1 5"/><path d="M5 9v11h14V9"/></svg>
                        }
                    </span>
                    <span class="sb-store-avatar__cam" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/><circle cx="12" cy="13" r="4"/></svg>
                    </span>
                </label>

                <div class="sb-store-banner-card__meta">
                    <h1>@st.Name</h1>
                    <div class="sb-store-banner-card__chips">
                        <a asp-controller="Store" asp-action="Detail" asp-route-slug="@st.Slug" target="_blank" class="sb-store-chip sb-store-chip--link">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>
                            /Store/@st.Slug
                        </a>
                        <span class="sb-store-chip">@st.ProductCount @L["məhsul"]</span>
                        <span class="sb-store-chip sb-store-chip--date">@st.CreatedDate.ToLocalTime().ToString("MMMM yyyy")@L["-dən"]</span>
                    </div>
                </div>

                <div class="sb-store-banner-card__status">
                    <label class="sb-store-status-toggle @(st.IsActive ? "is-on" : "is-off")" title="@(st.IsActive ? L["Aktiv mağaza"].Value : L["Deaktiv mağaza"].Value)">
                        <input type="checkbox" data-store-toggle data-store-id="@st.Id" @(st.IsActive ? "checked" : "") />
                        <span class="sb-store-status-toggle__slider"></span>
                        <span class="sb-store-status-toggle__label">@(st.IsActive ? L["Aktiv"].Value : L["Deaktiv"].Value)</span>
                    </label>
                </div>
            </div>

            <div class="sb-store-banner-card__error" data-store-img-error hidden></div>
        </div>

        @* ============== TEXT FORM ============== *@
        <form asp-action="StoreSettings" method="post" class="sb-prod-form" novalidate data-auth-form>
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""]?.Errors.Count > 0)
            {
                <div class="sb-form-summary">
                    @foreach (var err in ViewData.ModelState[""]!.Errors) { @err.ErrorMessage <br /> }
                </div>
            }

            @* ---- Əsas ---- *@
            <div class="sb-seller-card sb-prod-form__section">
                <header class="sb-seller-card__head">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"><path d="M3 9l1-5h16l1 5"/><path d="M5 9v11h14V9"/></svg>
                    <h2>@L["Əsas məlumatlar"]</h2>
                </header>

                <div class="sb-prod-form__grid">
                    <div class="sb-acc-field">
                        <label asp-for="Form.Name">@L["Mağaza adı *"]</label>
                        <input asp-for="Form.Name" maxlength="100" class="@(ViewData.ModelState["Form.Name"]?.Errors.Count > 0 ? "is-error" : "")" />
                        <span class="sb-field__error" asp-validation-for="Form.Name"></span>
                    </div>

                    <div class="sb-acc-field">
                        <label asp-for="Form.Slug">URL slug <small>@L["(boş = avtomatik addan)"]</small></label>
                        <input asp-for="Form.Slug" maxlength="120" placeholder="@st.Slug" />
                        <span class="sb-field__error" asp-validation-for="Form.Slug"></span>
                    </div>

                    <div class="sb-acc-field sb-prod-form__col-2">
                        <label asp-for="Form.Description">@L["Təsvir"] <small>@L["(mağazan haqqında qısa məlumat)"]</small></label>
                        <textarea asp-for="Form.Description" rows="4" maxlength="1000" placeholder="@L["Bakı mərkəzində 2020-ci ildən fəaliyyət göstərən qadın geyim mağazası..."]"></textarea>
                        <span class="sb-field__error" asp-validation-for="Form.Description"></span>
                    </div>

                    <div class="sb-acc-field">
                        <label asp-for="Form.ContactPhone">@L["Əlaqə telefonu"]</label>
                        <input asp-for="Form.ContactPhone" type="tel" maxlength="20" placeholder="+994501234567" />
                        <span class="sb-field__error" asp-validation-for="Form.ContactPhone"></span>
                    </div>

                    <div class="sb-acc-field">
                        <label asp-for="Form.Address">@L["Ünvan"]</label>
                        <input asp-for="Form.Address" maxlength="500" placeholder="@L["Bakı, Nəsimi r., Nizami küç."]" />
                        <span class="sb-field__error" asp-validation-for="Form.Address"></span>
                    </div>
                </div>
            </div>

            @* ---- Social channels ---- *@
            <div class="sb-seller-card sb-prod-form__section">
                <header class="sb-seller-card__head">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
                    <h2>@L["Əlaqə kanalları"]</h2>
                </header>
                <p class="sb-prod-form__field-hint">@L["Alıcılar məhsul səhifəsində bu kanallar üzərindən sənə yazacaq."]</p>

                <div class="sb-store-social-grid">
                    <div class="sb-store-social-row">
                        <span class="sb-seller-social-icon sb-seller-social-icon--wa">
                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.5 3.5C18.2 1.2 15.2 0 12 0 5.4 0 0 5.4 0 12c0 2.1.6 4.2 1.6 6L0 24l6.2-1.6c1.7.9 3.7 1.4 5.8 1.4 6.6 0 12-5.4 12-12 0-3.2-1.3-6.2-3.5-8.3zM12 21.8c-1.8 0-3.6-.5-5.1-1.4l-.4-.2-3.7.9.9-3.6-.2-.4c-1-1.6-1.5-3.4-1.5-5.1 0-5.5 4.5-9.9 9.9-9.9 2.7 0 5.2 1 7 2.9 1.9 1.9 2.9 4.4 2.9 7 .1 5.6-4.4 9.8-9.8 9.8z"/></svg>
                        </span>
                        <div class="sb-acc-field sb-store-social-row__field">
                            <label asp-for="Form.WhatsAppNumber">WhatsApp <small>@L["(yalnız rəqəm: ölkə kodu + nömrə)"]</small></label>
                            <input asp-for="Form.WhatsAppNumber" type="tel" maxlength="20" placeholder="994501234567" />
                            <span class="sb-field__error" asp-validation-for="Form.WhatsAppNumber"></span>
                        </div>
                    </div>

                    <div class="sb-store-social-row">
                        <span class="sb-seller-social-icon sb-seller-social-icon--ig">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                        </span>
                        <div class="sb-acc-field sb-store-social-row__field">
                            <label asp-for="Form.InstagramHandle">Instagram <small>@L["(@ olmadan)"]</small></label>
                            <input asp-for="Form.InstagramHandle" maxlength="60" placeholder="stylebazar" />
                            <span class="sb-field__error" asp-validation-for="Form.InstagramHandle"></span>
                        </div>
                    </div>

                    <div class="sb-store-social-row">
                        <span class="sb-seller-social-icon sb-seller-social-icon--tg">
                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9.04 15.46l-.36 5.07c.51 0 .73-.22 1-.49l2.4-2.3 4.97 3.64c.91.5 1.55.24 1.8-.84l3.26-15.27c.29-1.35-.49-1.88-1.38-1.55L1.36 9.69c-1.32.51-1.3 1.24-.23 1.57l4.94 1.54 11.46-7.22c.54-.36 1.03-.16.63.2"/></svg>
                        </span>
                        <div class="sb-acc-field sb-store-social-row__field">
                            <label asp-for="Form.TelegramHandle">Telegram <small>@L["(@ olmadan)"]</small></label>
                            <input asp-for="Form.TelegramHandle" maxlength="60" placeholder="stylebazar" />
                            <span class="sb-field__error" asp-validation-for="Form.TelegramHandle"></span>
                        </div>
                    </div>

                    <div class="sb-store-social-row">
                        <span class="sb-seller-social-icon sb-seller-social-icon--fb">
                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 10-11.6 9.9v-7H8v-3h2.4V9.4c0-2.4 1.4-3.7 3.6-3.7 1 0 2.1.2 2.1.2v2.3h-1.2c-1.2 0-1.5.7-1.5 1.5V12H16l-.4 3h-2.2v7A10 10 0 0022 12z"/></svg>
                        </span>
                        <div class="sb-acc-field sb-store-social-row__field">
                            <label asp-for="Form.FacebookHandle">Facebook <small>@L["(səhifə adı və ya ID)"]</small></label>
                            <input asp-for="Form.FacebookHandle" maxlength="60" placeholder="stylebazar.az" />
                            <span class="sb-field__error" asp-validation-for="Form.FacebookHandle"></span>
                        </div>
                    </div>

                    <div class="sb-store-social-row">
                        <span class="sb-seller-social-icon sb-seller-social-icon--tt">
                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19 9.5a6.5 6.5 0 01-4-1.37V17a5 5 0 11-5-5 4.7 4.7 0 011 .12V15a2.5 2.5 0 102 2.5V2h2.5a4 4 0 003.5 4z"/></svg>
                        </span>
                        <div class="sb-acc-field sb-store-social-row__field">
                            <label asp-for="Form.TikTokHandle">TikTok <small>@L["(@ olmadan)"]</small></label>
                            <input asp-for="Form.TikTokHandle" maxlength="60" placeholder="stylebazar" />
                            <span class="sb-field__error" asp-validation-for="Form.TikTokHandle"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="sb-prod-form__footer">
                <a asp-action="Dashboard" class="sb-btn-ghost">@L["Geri"]</a>
                <button type="submit" class="sb-btn-primary sb-btn-primary--cyan sb-btn-primary--lg" data-submit>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                    <span>@L["Yadda saxla"]</span>
                </button>
            </div>
        </form>
    </main>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
