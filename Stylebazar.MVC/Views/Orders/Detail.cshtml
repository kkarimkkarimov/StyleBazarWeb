@using Stylebazar.DAL.Entities.Enums
@model Stylebazar.BLL.DTOs.Orders.OrderDetailDto
@{
    ViewData["Title"] = L["Sifariş"].Value + " #" + Model.Id;
    bool cancelled = Model.Status == OrderStatus.Cancelled;

    // Zaman xətti addımları (Ləğv olunmayıbsa).
    var steps = new[]
    {
        (Title: L["Sifariş verildi"].Value, Done: true, When: (DateTime?)Model.CreatedDate),
        (Title: L["Ödəniş alındı"].Value, Done: Model.IsPaid, When: Model.PaidAt),
        (Title: L["Göndərildi"].Value, Done: Model.ShippedAt != null, When: Model.ShippedAt),
        (Title: L["Çatdırıldı"].Value, Done: Model.DeliveredAt != null, When: Model.DeliveredAt)
    };
}

<section style="max-width:880px; margin:0 auto; padding:24px 16px;">
    <a asp-action="Index" style="color:#888; text-decoration:none; font-size:.9rem;">← @L["Sifarişlərə qayıt"]</a>
    <h1 style="font-family:'Playfair Display',serif; margin:10px 0 4px;">@L["Sifariş"] #@Model.Id</h1>
    <p style="color:#888; margin-top:0;">@Model.CreatedDate.ToLocalTime().ToString("dd MMMM yyyy, HH:mm")</p>

    @if (TempData["Success"] is string ok)
    {
        <div style="background:#eafaf1; color:#1e8449; padding:12px 16px; border-radius:10px; margin:12px 0;">@ok</div>
    }

    @if (cancelled)
    {
        <div style="background:#fdecea; color:#a93226; padding:14px 18px; border-radius:12px; margin:16px 0; font-weight:600;">
            @L["Bu sifariş ləğv edilib."]
            @if (Model.CancelledAt != null) { <text> (@Model.CancelledAt.Value.ToLocalTime().ToString("dd.MM.yyyy"))</text> }
        </div>
    }
    else
    {
        <!-- STATUS ZAMAN XƏTTİ -->
        <div style="display:flex; justify-content:space-between; margin:24px 0 28px; position:relative;">
            @for (int i = 0; i < steps.Length; i++)
            {
                var st = steps[i];
                <div style="flex:1; text-align:center; position:relative;">
                    @if (i > 0)
                    {
                        <div style="position:absolute; top:14px; right:50%; width:100%; height:3px; background:@(st.Done ? "#1e8449" : "#e6e6e6"); z-index:0;"></div>
                    }
                    <div style="position:relative; z-index:1; width:30px; height:30px; border-radius:50%; margin:0 auto 8px; display:flex; align-items:center; justify-content:center; color:#fff; background:@(st.Done ? "#1e8449" : "#cfcfcf");">
                        @(st.Done ? "✓" : (i + 1).ToString())
                    </div>
                    <div style="font-size:.82rem; font-weight:600; color:@(st.Done ? "#1b1b1b" : "#999");">@st.Title</div>
                    @if (st.When != null)
                    {
                        <div style="font-size:.72rem; color:#aaa;">@st.When.Value.ToLocalTime().ToString("dd.MM HH:mm")</div>
                    }
                </div>
            }
        </div>
    }

    <div style="display:grid; grid-template-columns:1fr 300px; gap:20px; align-items:start;" class="sb-order-grid">
        <!-- MƏHSULLAR -->
        <div style="border:1px solid #eee; border-radius:12px; padding:18px; background:#fff;">
            <h3 style="margin-top:0;">@L["Məhsullar"]</h3>
            @foreach (var item in Model.Items)
            {
                <div style="display:flex; gap:12px; padding:10px 0; border-bottom:1px solid #f2f2f2;">
                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/img/placeholder.svg" : item.ImageUrl)" alt="@item.ProductName"
                         style="width:60px; height:60px; object-fit:cover; border-radius:8px;" />
                    <div style="flex:1;">
                        @if (!string.IsNullOrEmpty(item.ProductSlug))
                        {
                            <a asp-controller="Shop" asp-action="Detail" asp-route-slug="@item.ProductSlug" style="font-weight:600; color:inherit; text-decoration:none;">@item.ProductName</a>
                        }
                        else
                        {
                            <span style="font-weight:600;">@item.ProductName</span>
                        }
                        <div style="color:#888; font-size:.82rem; margin-top:2px;">
                            @item.StoreName · @item.Quantity × @item.UnitPrice.ToString("0.##") ₼
                            @if (!string.IsNullOrEmpty(item.Size)) { <text> · @L["Ölçü"]: @item.Size</text> }
                            @if (!string.IsNullOrEmpty(item.Color)) { <text> · @L["Rəng"]: @item.Color</text> }
                        </div>
                    </div>
                    <strong>@item.LineTotal.ToString("0.##") ₼</strong>
                </div>
            }
            <div style="display:flex; justify-content:space-between; padding-top:14px; font-size:1.1rem; font-weight:700;">
                <span>@L["Cəmi"]</span>
                <span>@Model.TotalAmount.ToString("0.##") ₼</span>
            </div>
        </div>

        <!-- ÇATDIRILMA ÜNVANI -->
        <aside style="border:1px solid #eee; border-radius:12px; padding:18px; background:#fff;">
            <h3 style="margin-top:0;">@L["Çatdırılma"]</h3>
            <p style="margin:6px 0; line-height:1.6;">
                <strong>@Model.ShipFullName</strong><br />
                @Model.ShipPhone<br />
                @Model.ShipCity@(string.IsNullOrEmpty(Model.ShipDistrict) ? "" : ", " + Model.ShipDistrict)<br />
                @Model.ShipAddressLine
                @if (!string.IsNullOrEmpty(Model.ShipPostalCode)) { <br /><text>@Model.ShipPostalCode</text> }
            </p>
            @if (!string.IsNullOrEmpty(Model.ShipNotes))
            {
                <p style="color:#888; font-size:.85rem; margin-top:8px;">@L["Qeyd"]: @Model.ShipNotes</p>
            }
        </aside>
    </div>
</section>
