@using Stylebazar.DAL.Entities.Enums
@model Stylebazar.BLL.DTOs.Orders.OrderDetailDto
@{
    ViewData["Title"] = L["Sifariş"].Value + " #" + Model.Id;
    bool cancelled = Model.Status == OrderStatus.Cancelled;

    var steps = new[]
    {
        (Title: L["Sifariş verildi"].Value, Done: true, When: (DateTime?)Model.CreatedDate),
        (Title: L["Ödəniş alındı"].Value, Done: Model.IsPaid, When: Model.PaidAt),
        (Title: L["Göndərildi"].Value, Done: Model.ShippedAt != null, When: Model.ShippedAt),
        (Title: L["Çatdırıldı"].Value, Done: Model.DeliveredAt != null, When: Model.DeliveredAt)
    };
}

<section class="sb-commerce">
    <a class="sb-order-back" asp-action="Index">← @L["Sifarişlərə qayıt"]</a>
    <div class="sb-commerce__head">
        <div>
            <h1 class="sb-commerce__title">@L["Sifariş"] #@Model.Id</h1>
            <p class="sb-commerce__sub">@Model.CreatedDate.ToLocalTime().ToString("dd MMMM yyyy, HH:mm")</p>
        </div>
    </div>

    @if (TempData["Success"] is string ok)
    {
        <div class="sb-alert sb-alert--ok">@ok</div>
    }

    @if (cancelled)
    {
        <div class="sb-order-cancelled">
            @L["Bu sifariş ləğv edilib."]
            @if (Model.CancelledAt != null) { <text> (@Model.CancelledAt.Value.ToLocalTime().ToString("dd.MM.yyyy"))</text> }
        </div>
    }
    else
    {
        <div class="sb-timeline">
            @foreach (var st in steps)
            {
                <div class="sb-timeline__step @(st.Done ? "is-done" : "")">
                    <div class="sb-timeline__dot">
                        @if (st.Done)
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        }
                    </div>
                    <div class="sb-timeline__label">@st.Title</div>
                    @if (st.When != null)
                    {
                        <div class="sb-timeline__time">@st.When.Value.ToLocalTime().ToString("dd.MM HH:mm")</div>
                    }
                </div>
            }
        </div>
    }

    <div class="sb-order-detail-grid">
        <div class="sb-panel" style="margin-bottom:0;">
            <h2 class="sb-panel__title">@L["Məhsullar"]</h2>
            @foreach (var item in Model.Items)
            {
                <div class="sb-miniline">
                    <img class="sb-miniline__img" src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/img/placeholder.svg" : item.ImageUrl)" alt="@item.ProductName" loading="lazy" />
                    <div class="sb-miniline__body">
                        @if (!string.IsNullOrEmpty(item.ProductSlug))
                        {
                            <a class="sb-miniline__name" asp-controller="Shop" asp-action="Detail" asp-route-slug="@item.ProductSlug">@item.ProductName</a>
                        }
                        else
                        {
                            <span class="sb-miniline__name">@item.ProductName</span>
                        }
                        <div class="sb-miniline__meta">
                            @item.StoreName · @item.Quantity × @item.UnitPrice.ToString("0.##") ₼
                            @if (!string.IsNullOrEmpty(item.Size)) { <text> · @L["Ölçü"]: @item.Size</text> }
                            @if (!string.IsNullOrEmpty(item.Color)) { <text> · @L["Rəng"]: @item.Color</text> }
                        </div>
                    </div>
                    <span class="sb-miniline__price">@item.LineTotal.ToString("0.##") ₼</span>
                </div>
            }
            <div class="sb-summary__total" style="margin-top:14px;">
                <span>@L["Cəmi"]</span>
                <b>@Model.TotalAmount.ToString("0.##") ₼</b>
            </div>
        </div>

        <aside class="sb-order-side-card">
            <h2 class="sb-panel__title">@L["Çatdırılma"]</h2>
            <p class="sb-order-ship">
                <strong>@Model.ShipFullName</strong><br />
                @Model.ShipPhone<br />
                @Model.ShipCity@(string.IsNullOrEmpty(Model.ShipDistrict) ? "" : ", " + Model.ShipDistrict)<br />
                @Model.ShipAddressLine
                @if (!string.IsNullOrEmpty(Model.ShipPostalCode)) { <br /><text>@Model.ShipPostalCode</text> }
            </p>
            @if (!string.IsNullOrEmpty(Model.ShipNotes))
            {
                <p class="sb-commerce__sub" style="margin-top:8px; font-size:.85rem;">@L["Qeyd"]: @Model.ShipNotes</p>
            }
        </aside>
    </div>
</section>
