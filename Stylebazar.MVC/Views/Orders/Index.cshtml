@using Stylebazar.DAL.Entities.Enums
@model List<Stylebazar.BLL.DTOs.Orders.OrderListItemDto>
@{
    ViewData["Title"] = L["Sifarişlərim"].Value;

    (string Label, string Bg, string Fg) StatusChip(OrderStatus s) => s switch
    {
        OrderStatus.Pending => (L["Ödəniş gözlənilir"].Value, "#fff4e5", "#b26a00"),
        OrderStatus.Processing => (L["Hazırlanır"].Value, "#e7f0ff", "#1b5fbf"),
        OrderStatus.Shipped => (L["Göndərilib"].Value, "#efe7ff", "#6b34c4"),
        OrderStatus.Delivered => (L["Çatdırılıb"].Value, "#e6f7ec", "#1e8449"),
        OrderStatus.Cancelled => (L["Ləğv edilib"].Value, "#fdecea", "#a93226"),
        _ => (s.ToString(), "#eee", "#555")
    };
}

<section style="max-width:900px; margin:0 auto; padding:24px 16px;">
    <h1 style="font-family:'Playfair Display',serif; margin-bottom:20px;">@L["Sifarişlərim"]</h1>

    @if (TempData["Success"] is string ok)
    {
        <div style="background:#eafaf1; color:#1e8449; padding:12px 16px; border-radius:10px; margin-bottom:16px;">@ok</div>
    }
    @if (TempData["Error"] is string err)
    {
        <div style="background:#fdecea; color:#a93226; padding:12px 16px; border-radius:10px; margin-bottom:16px;">@err</div>
    }

    @if (!Model.Any())
    {
        <div style="text-align:center; padding:64px 20px; border:1px dashed #ddd; border-radius:14px; background:#fafafa;">
            <p style="font-size:1.1rem; color:#666; margin-bottom:16px;">@L["Hələ heç bir sifarişin yoxdur."]</p>
            <a asp-controller="Shop" asp-action="Index" class="sb-btn sb-btn--primary">@L["Alış-verişə başla"]</a>
        </div>
    }
    else
    {
        foreach (var o in Model)
        {
            var chip = StatusChip(o.Status);
            <a asp-action="Detail" asp-route-id="@o.Id"
               style="display:flex; gap:16px; align-items:center; padding:16px; border:1px solid #eee; border-radius:12px; margin-bottom:12px; background:#fff; text-decoration:none; color:inherit;">
                <img src="@(string.IsNullOrEmpty(o.FirstImageUrl) ? "/img/placeholder.svg" : o.FirstImageUrl)" alt=""
                     style="width:64px; height:64px; object-fit:cover; border-radius:8px; flex:0 0 auto;" />
                <div style="flex:1; min-width:0;">
                    <div style="font-weight:600;">@L["Sifariş"] #@o.Id</div>
                    <div style="color:#888; font-size:.85rem; margin-top:2px;">
                        @o.CreatedDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @o.ItemCount @L["məhsul"] (@o.TotalQuantity @L["ədəd"])
                    </div>
                </div>
                <div style="text-align:right; flex:0 0 auto;">
                    <span style="display:inline-block; font-size:.74rem; padding:3px 10px; border-radius:20px; background:@chip.Bg; color:@chip.Fg; margin-bottom:6px;">@chip.Label</span>
                    <div style="font-weight:700;">@o.TotalAmount.ToString("0.##") ₼</div>
                </div>
            </a>
        }
    }
</section>
