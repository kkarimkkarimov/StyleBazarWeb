@using Stylebazar.DAL.Entities.Enums
@model OrderHistoryViewModel
@{
    ViewData["Title"] = "Sifarişlərim";
}

@functions {
    string StatusLabel(OrderStatus s) => s switch
    {
        OrderStatus.Pending => "Yeni",
        OrderStatus.Confirmed => "Təsdiqləndi",
        OrderStatus.Processing => "Hazırlanır",
        OrderStatus.Shipped => "Yolda",
        OrderStatus.Delivered => "Çatdırıldı",
        OrderStatus.Cancelled => "Ləğv olundu",
        OrderStatus.Returned => "Geri qaytarıldı",
        _ => s.ToString()
    };
    string StatusClass(OrderStatus s) => s switch
    {
        OrderStatus.Pending => "is-pending",
        OrderStatus.Confirmed or OrderStatus.Processing => "is-progress",
        OrderStatus.Shipped => "is-shipped",
        OrderStatus.Delivered => "is-success",
        OrderStatus.Cancelled or OrderStatus.Returned => "is-cancelled",
        _ => ""
    };
}

<header class="sb-shop__header">
    <span class="sb-eyebrow">Hesabım</span>
    <h1>Sifarişlərim</h1>
    <p>Bütün sifarişlərinin tarixçəsi və hazırkı statusu.</p>
</header>

@if (!Model.Orders.Items.Any())
{
    <div class="sb-wishlist-empty">
        <div class="sb-wishlist-empty__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
        </div>
        <h2>Sifariş tarixçəsi boşdur</h2>
        <p>İlk sifarişin burada görsənəcək.</p>
        <a asp-controller="Shop" asp-action="Index" class="sb-btn-primary">Mağazaya keç</a>
    </div>
}
else
{
    <div class="sb-orders-list">
        @foreach (var o in Model.Orders.Items)
        {
            <a class="sb-order-card" asp-controller="Order" asp-action="Detail" asp-route-id="@o.Id">
                <div class="sb-order-card__media">
                    @if (!string.IsNullOrEmpty(o.FirstItemImageUrl))
                    {
                        <img src="@o.FirstItemImageUrl" alt="@o.FirstItemName" loading="lazy" />
                    }
                    else
                    {
                        <div class="sb-product__media-fallback">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                        </div>
                    }
                </div>
                <div class="sb-order-card__body">
                    <div class="sb-order-card__row">
                        <strong>@o.OrderNumber</strong>
                        <span class="sb-order-status @StatusClass(o.Status)">@StatusLabel(o.Status)</span>
                    </div>
                    <p class="sb-order-card__meta">@o.ItemCount məhsul · @o.CreatedDate.ToString("dd MMM yyyy, HH:mm")</p>
                    <p class="sb-order-card__items">@o.FirstItemName@(o.ItemCount > 1 ? $" və {o.ItemCount - 1} başqa məhsul" : "")</p>
                </div>
                <div class="sb-order-card__price">
                    <span>Cəm</span>
                    <strong>@o.Total.ToString("N2") ₼</strong>
                </div>
            </a>
        }
    </div>

    @if (Model.Orders.Pages > 1)
    {
        <nav class="sb-pagination" aria-label="Pagination">
            @for (int p = 1; p <= Model.Orders.Pages; p++)
            {
                <a class="sb-pagination__item @(p == Model.Orders.Index + 1 ? "is-current" : "")" asp-route-page="@p">@p</a>
            }
        </nav>
    }
}
