@model OrderDetailViewModel
@{
    ViewData["Title"] = "Sifariş yerləşdirildi";
    var o = Model.Order;
}

<section class="sb-order-success">
    <div class="sb-order-success__icon">
        <svg viewBox="0 0 52 52" aria-hidden="true">
            <circle class="sb-tick__circle" cx="26" cy="26" r="25" fill="none" stroke="currentColor" stroke-width="2"/>
            <path class="sb-tick__check" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" d="M14 27l8 8 16-18"/>
        </svg>
    </div>
    <h1>Sifariş yerləşdirildi</h1>
    <p class="sb-order-success__sub">Sifarişin uğurla qeydə alındı. Tezliklə səninlə əlaqə saxlayacağıq.</p>

    <div class="sb-order-success__card">
        <div class="sb-order-success__card-row">
            <span>Sifariş nömrəsi</span>
            <strong>@o.OrderNumber</strong>
        </div>
        <div class="sb-order-success__card-row">
            <span>Cəm</span>
            <strong>@o.Total.ToString("N2") ₼</strong>
        </div>
        <div class="sb-order-success__card-row">
            <span>Çatdırılma</span>
            <strong>@o.ShipFullName · @o.ShipCity</strong>
        </div>
        <div class="sb-order-success__card-row">
            <span>Ödəniş</span>
            <strong>@(o.PaymentMethod.ToString() == "CashOnDelivery" ? "Çatdırılma zamanı nağd" : o.PaymentMethod.ToString())</strong>
        </div>
    </div>

    <div class="sb-order-success__actions">
        <a asp-controller="Order" asp-action="Detail" asp-route-id="@o.Id" class="sb-btn-primary">
            <span>Sifariş detalına bax</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a asp-controller="Shop" asp-action="Index" class="sb-btn-ghost">Mağazaya qayıt</a>
    </div>
</section>
