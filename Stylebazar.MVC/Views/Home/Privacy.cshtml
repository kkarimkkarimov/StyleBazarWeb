@{
    ViewData["Title"] = L["Gizlilik"].Value;
}

<section class="sb-section" style="max-width: 720px; margin: 24px auto;">
    <span class="sb-eyebrow">@L["Hüquqi"]</span>
    <h1>@L["Gizlilik siyasəti"]</h1>
    <p class="sb-muted">
        @L["StyleBazar istifadəçilərinin şəxsi məlumatlarının qorunmasına önəm verir. Aşağıda hansı məlumatları topladığımız və necə istifadə etdiyimiz qısaca göstərilib."]
    </p>

    <h3 style="margin-top: 32px;">@L["Toplanan məlumat"]</h3>
    <ul class="sb-muted">
        <li>@L["Ad, e-mail, parol (yalnız hash şəklində saxlanılır)"]</li>
        <li>@L["Profil şəkli, bio (istəyə görə)"]</li>
        <li>@L["Sifarişlər, wishlist, rəylər"]</li>
    </ul>

    <h3 style="margin-top: 32px;">@L["Hüquqların"]</h3>
    <p class="sb-muted">
        @L["Profilini istənilən vaxt redaktə və ya silə bilərsən. Hər hansı sual üçün"]
        <a href="mailto:support@stylebazar.az">support@stylebazar.az</a> @L["ünvanına yaz."]
    </p>
</section>
