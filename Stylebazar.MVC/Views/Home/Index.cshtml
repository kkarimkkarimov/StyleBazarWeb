@model HomeIndexViewModel
@using Microsoft.AspNetCore.Identity
@using Stylebazar.DAL.Entities
@inject SignInManager<AppUser> SignInManager
@{
    ViewData["Title"] = "Ana səhifə";
    ViewData["WishlistIds"] = Model.WishlistProductIds;
    // Inline-shape the JSON so the JS doesn't depend on JsonSerializer defaults
    // (PascalCase + integer enums). Match the property names the viewer JS reads,
    // and emit MediaType as a string ("Image" / "Video") for the type switch.
    var storiesJson = System.Text.Json.JsonSerializer.Serialize(Model.Stories.Select(g => new {
        storeId = g.StoreId,
        storeName = g.StoreName,
        storeSlug = g.StoreSlug,
        storeProfileImageUrl = g.StoreProfileImageUrl,
        storeOwnerId = g.StoreOwnerId,
        stories = g.Stories.Select(s => new {
            id = s.Id,
            mediaUrl = s.MediaUrl,
            mediaType = s.MediaType.ToString(),
            durationSeconds = s.DurationSeconds,
            thumbnailUrl = s.ThumbnailUrl,
            caption = s.Caption,
            linkUrl = s.LinkUrl
        })
    }));
}

@* ============== HERO BANNER RAIL — admin-curated, auto-rotating ============== *@
@if (Model.HeroBanners.Any())
{
    <section id="sbHeroCarousel" class="sb-hero-rail @(Model.HeroBanners.Count > 1 ? "sb-hero-rail--carousel" : "")" data-hero-rail data-autoplay="6000" aria-roledescription="carousel">
        <div class="sb-hero-rail__track" data-hero-track>
            @for (int i = 0; i < Model.HeroBanners.Count; i++)
            {
                var b = Model.HeroBanners[i];
                <article class="sb-hero-slide @(i == 0 ? "is-active" : "")"
                         data-hero-slide="@i"
                         aria-hidden="@(i == 0 ? "false" : "true")"
                         style="@(string.IsNullOrEmpty(b.ImageUrl) ? "" : $"background-image: url('{b.ImageUrl}');")">
                    <div class="sb-hero-slide__overlay"></div>
                    <div class="sb-hero-slide__inner">
                        @if (!string.IsNullOrEmpty(b.Eyebrow))
                        {
                            <span class="sb-hero-slide__eyebrow">@b.Eyebrow</span>
                        }
                        <h1 class="sb-hero-slide__title">@b.Title</h1>
                        @if (!string.IsNullOrEmpty(b.Subtitle))
                        {
                            <p class="sb-hero-slide__subtitle">@b.Subtitle</p>
                        }
                        @if (!string.IsNullOrEmpty(b.CtaUrl) && !string.IsNullOrEmpty(b.CtaText))
                        {
                            <a class="sb-btn sb-btn--accent sb-btn--lg sb-hero-slide__cta" href="@b.CtaUrl">@b.CtaText</a>
                        }
                    </div>
                </article>
            }
        </div>

        @if (Model.HeroBanners.Count > 1)
        {
            <button type="button" class="sb-hero-rail__nav sb-hero-rail__nav--prev" data-hero-prev aria-label="Əvvəlki banner">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button type="button" class="sb-hero-rail__nav sb-hero-rail__nav--next" data-hero-next aria-label="Növbəti banner">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
            <div class="sb-hero-rail__dots" data-hero-dots role="tablist">
                @for (int i = 0; i < Model.HeroBanners.Count; i++)
                {
                    <button type="button" class="sb-hero-rail__dot @(i == 0 ? "is-active" : "")"
                            data-hero-dot="@i" role="tab"
                            aria-label="Banner @(i + 1)"
                            aria-selected="@(i == 0 ? "true" : "false")"></button>
                }
            </div>
        }
    </section>
}

@* ============== FEATURED — pastel lilac rail with arrow nav ============== *@
<section class="sb-tile sb-tile--lilac">
    <header class="sb-tile__head">
        <h2>Seçilmiş məhsullar</h2>
        <a asp-controller="Shop" asp-action="Index" asp-route-isFeatured="true" class="sb-tile__view-all">
            Hamısına bax
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
    </header>

    @if (Model.FeaturedProducts.Any())
    {
        <div class="sb-tile__rail-wrap">
            <button type="button" class="sb-tile__nav sb-tile__nav--prev" data-rail-prev aria-label="Sol">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <div class="sb-tile__rail" data-rail>
                @{
                    ViewData["CardVariant"] = "compact";
                }
                @foreach (var p in Model.FeaturedProducts)
                {
                    <partial name="_ProductCard" model="p" />
                }
                @{
                    ViewData["CardVariant"] = "rich";
                }
            </div>
            <button type="button" class="sb-tile__nav sb-tile__nav--next" data-rail-next aria-label="Sağ">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
        </div>
    }
    else
    {
        <div class="sb-tile__empty"><span>İlk seçilmişlər tezliklə burada görsənəcək.</span></div>
    }
</section>

@* ============== STORIES — pastel blush rail ============== *@
@if (Model.Stories.Any())
{
    <section class="sb-tile sb-tile--blush">
        <header class="sb-tile__head">
            <h2>Hekayələr</h2>
        </header>
        <div class="sb-stories-rail" id="sbStoriesRail">
            @foreach (var storeGroup in Model.Stories)
            {
                <button type="button" class="sb-story-item"
                        data-story-store-id="@storeGroup.StoreId"
                        data-store-name="@storeGroup.StoreName">
                    <span class="sb-story-item__ring">
                        <span class="sb-story-item__avatar">
                            @if (!string.IsNullOrEmpty(storeGroup.StoreProfileImageUrl))
                            {
                                <img src="@storeGroup.StoreProfileImageUrl" alt="@storeGroup.StoreName" loading="lazy" />
                            }
                            else
                            {
                                <span class="sb-story-item__initial">@(storeGroup.StoreName.Length > 0 ? storeGroup.StoreName[0].ToString().ToUpper() : "S")</span>
                            }
                        </span>
                    </span>
                    <span class="sb-story-item__name">@storeGroup.StoreName</span>
                </button>
            }
        </div>
    </section>
}

@* ============== PRODUCTS — pastel mint grid (rich cards) ============== *@
<section class="sb-tile sb-tile--mint">
    <header class="sb-tile__head">
        <h2>Məhsullar</h2>
        <a asp-controller="Shop" asp-action="Index" class="sb-tile__view-all">
            Hamısına bax
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
    </header>

    @if (Model.LatestProducts.Any())
    {
        <div class="sb-tile__grid">
            @foreach (var p in Model.LatestProducts)
            {
                <partial name="_ProductCard" model="p" />
            }
        </div>
    }
    else
    {
        <div class="sb-tile__empty"><span>İlk məhsullar tezliklə görsənəcək.</span></div>
    }
</section>

@* ============== NEWSLETTER — ink-dark CTA with AJAX form ============== *@
<section class="sb-section">
    <div class="sb-newsletter">
        <span class="sb-eyebrow" style="color: rgba(255,255,255,.6);">Yeniliklərə abunə</span>
        <h2>İlk biz xəbər verək</h2>
        <p>Yeni mağazalar, kolleksiyalar və endirimlər — həftədə bir email, spam yox.</p>
        <form id="sbNewsletterForm" novalidate>
            @Html.AntiForgeryToken()
            <input type="email" name="email" placeholder="sen@example.com" required autocomplete="email" aria-label="Email" />
            <button type="submit" class="sb-btn sb-btn--accent">Abunə ol</button>
        </form>
        <div id="sbNewsletterResult" class="sb-newsletter__result" aria-live="polite"></div>
    </div>
</section>

@* ============== STORY VIEWER MODAL ============== *@
<div class="sb-story-viewer" id="sbStoryViewer" aria-hidden="true">
    <button type="button" class="sb-story-viewer__close" id="sbStoryClose" aria-label="Bağla">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div class="sb-story-viewer__frame">
        <div class="sb-story-viewer__progress" id="sbStoryProgress"></div>
        <header class="sb-story-viewer__head">
            <span class="sb-story-viewer__avatar" id="sbStoryAvatar"></span>
            <span class="sb-story-viewer__store" id="sbStoryStoreName"></span>
            <button type="button" class="sb-story-viewer__mute" id="sbStoryMute" hidden aria-label="Səssiz / səsli">
                <svg class="sb-story-viewer__mute-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
                <svg class="sb-story-viewer__mute-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" hidden><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M19.07 4.93a10 10 0 010 14.14M15.54 8.46a5 5 0 010 7.07"/></svg>
            </button>
        </header>
        <div class="sb-story-viewer__media">
            <img class="sb-story-viewer__img" id="sbStoryImage" alt="" hidden />
            <video class="sb-story-viewer__vid" id="sbStoryVideo" playsinline muted hidden></video>
        </div>
        <span class="sb-story-viewer__caption" id="sbStoryCaption"></span>
        <button type="button" class="sb-story-viewer__tap sb-story-viewer__tap--prev" id="sbStoryTapPrev" aria-label="Əvvəlki"></button>
        <button type="button" class="sb-story-viewer__tap sb-story-viewer__tap--next" id="sbStoryTapNext" aria-label="Növbəti"></button>
        @* Reply input — wired up in Phase 14.7. Rendered only for signed-in
           users (anonymous viewers can still watch, just can't reply). *@
        @if (SignInManager.IsSignedIn(User))
        {
            <form class="sb-story-viewer__reply" id="sbStoryReply" hidden>
                <input type="text" placeholder="Hekayəyə cavab yaz..." maxlength="500" autocomplete="off" />
                <button type="submit" aria-label="Göndər">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                </button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <script id="sbStoriesData" type="application/json">@Html.Raw(storiesJson)</script>
}
