@model HomeIndexViewModel
@{
    ViewData["Title"] = "Ana səhifə";
    // Published for _ProductCard so each card can paint its initial heart state.
    ViewData["WishlistIds"] = Model.WishlistProductIds;
}

@* ============== HERO CAROUSEL (DB-driven, fallback to default if empty) ============== *@
<section class="sb-hero-carousel" id="sbHeroCarousel" data-autoplay="6000" aria-label="Editorial banners">
    @if (Model.Banners.Any())
    {
        var i = 0;
        foreach (var b in Model.Banners)
        {
            var bg = !string.IsNullOrEmpty(b.ImageUrl)
                ? $"background-image:url('{b.ImageUrl}');"
                : "";
            var slideClass = string.IsNullOrEmpty(b.ImageUrl) ? "sb-hero-slide sb-hero-slide--no-image" : "sb-hero-slide";
            var active = i == 0 ? "is-active" : "";
            <article class="@slideClass @active" data-slide-index="@i" style="@bg">
                <div class="sb-hero-slide__inner">
                    @if (!string.IsNullOrEmpty(b.Eyebrow))
                    {
                        <span class="sb-hero-slide__eyebrow">@b.Eyebrow</span>
                    }
                    <h1 class="sb-hero-slide__title">@b.Title</h1>
                    @if (!string.IsNullOrEmpty(b.Subtitle))
                    {
                        <p class="sb-hero-slide__sub">@b.Subtitle</p>
                    }
                    @if (!string.IsNullOrEmpty(b.CtaText) && !string.IsNullOrEmpty(b.CtaUrl))
                    {
                        <a class="sb-btn sb-btn--primary sb-btn--lg" href="@b.CtaUrl">
                            @b.CtaText
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                        </a>
                    }
                </div>
            </article>
            i++;
        }
    }
    else
    {
        @* Default slide when admin hasn't added any banners *@
        <article class="sb-hero-slide sb-hero-slide--no-image is-active" data-slide-index="0">
            <div class="sb-hero-slide__inner">
                <span class="sb-hero-slide__eyebrow">Yeni nəsil moda platforması</span>
                <h1 class="sb-hero-slide__title">Stilini tap, <em style="font-style: italic; color: var(--sb-accent);">satıcısını seç.</em></h1>
                <p class="sb-hero-slide__sub">Yerli mağazalardan brend geyimləri kəşf et, sevimlilərini saxla, real rəylərlə əmin ol.</p>
                <div style="display: flex; gap: 12px; flex-wrap: wrap;">
                    <a class="sb-btn sb-btn--primary sb-btn--lg" asp-controller="Shop" asp-action="Index">
                        Mağazaya bax
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </a>
                    <a class="sb-btn sb-btn--ghost sb-btn--lg" asp-controller="Account" asp-action="Register">
                        Satıcı kimi qoşul
                    </a>
                </div>
            </div>
        </article>
    }

    @if (Model.Banners.Count > 1)
    {
        <div class="sb-hero-controls">
            <button class="sb-hero-arrow sb-hero-arrow--prev" type="button" aria-label="Əvvəlki" data-hero-prev>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button class="sb-hero-arrow sb-hero-arrow--next" type="button" aria-label="Növbəti" data-hero-next>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
            <div class="sb-hero-dots" data-hero-dots>
                @for (var i = 0; i < Model.Banners.Count; i++)
                {
                    <button type="button" class="@(i == 0 ? "is-active" : "")" data-hero-dot="@i" aria-label="Banner @(i+1)"></button>
                }
            </div>
        </div>
    }
</section>

@* ============== STORIES RAIL ============== *@
@if (Model.Stories.Any())
{
    <section class="sb-section sb-reveal">
        <div class="sb-section-head">
            <div>
                <span class="sb-eyebrow">Hekayələr</span>
                <h2>Satıcılardan canlı</h2>
            </div>
        </div>
        <div class="sb-stories-rail" id="sbStoriesRail">
            @{
                var storiesJson = System.Text.Json.JsonSerializer.Serialize(Model.Stories);
            }
            @foreach (var ss in Model.Stories)
            {
                var initial = !string.IsNullOrEmpty(ss.StoreName) ? ss.StoreName.Substring(0, 1).ToUpper() : "?";
                <button type="button" class="sb-story-item" data-story-store-id="@ss.StoreId" aria-label="@ss.StoreName hekayələrini aç">
                    <span class="sb-story-item__ring">
                        <span class="sb-story-item__avatar">
                            @if (!string.IsNullOrEmpty(ss.StoreProfileImageUrl))
                            {
                                <img src="@ss.StoreProfileImageUrl" alt="@ss.StoreName" loading="lazy" />
                            }
                            else
                            {
                                @initial
                            }
                        </span>
                    </span>
                    <span class="sb-story-item__name">@ss.StoreName</span>
                </button>
            }
        </div>
        <script id="sbStoriesData" type="application/json">@Html.Raw(storiesJson)</script>
    </section>
}

@* ============== CATEGORIES ============== *@
@if (Model.Categories.Any())
{
    <section class="sb-section sb-reveal">
        <div class="sb-section-head">
            <div>
                <span class="sb-eyebrow">Kateqoriyalar</span>
                <h2>Sevdiyini tap</h2>
            </div>
            <a class="sb-section-head__link" asp-controller="Shop" asp-action="Index">Hamısı →</a>
        </div>
        <div class="sb-cat-strip">
            @foreach (var cat in Model.Categories)
            {
                <a class="sb-cat-pill" asp-controller="Shop" asp-action="Index" asp-route-categoryId="@cat.Id">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20.59 13.41L13.42 20.58a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                    @cat.Name
                </a>
            }
        </div>
    </section>
}

@* ============== FEATURED CAROUSEL ============== *@
@if (Model.FeaturedProducts.Any())
{
    <section class="sb-section sb-reveal">
        <div class="sb-section-head">
            <div>
                <span class="sb-eyebrow">Editorial</span>
                <h2>Önə çıxanlar</h2>
            </div>
            <a class="sb-section-head__link" asp-controller="Shop" asp-action="Index" asp-route-isFeatured="true">Hamısı →</a>
        </div>
        <div class="sb-product-rail-wrap">
            <button class="sb-product-rail-arrow sb-product-rail-arrow--prev" type="button" aria-label="Əvvəlki" data-rail-prev="featured">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <div class="sb-product-rail" id="sbFeaturedRail" data-rail="featured">
                @foreach (var p in Model.FeaturedProducts)
                {
                    <partial name="_ProductCard" model="p" />
                }
            </div>
            <button class="sb-product-rail-arrow sb-product-rail-arrow--next" type="button" aria-label="Növbəti" data-rail-next="featured">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
        </div>
    </section>
}

@* ============== LATEST ============== *@
<section class="sb-section sb-reveal">
    <div class="sb-section-head">
        <div>
            <span class="sb-eyebrow">Mağaza</span>
            <h2>Yeni gələnlər</h2>
        </div>
        <a class="sb-section-head__link" asp-controller="Shop" asp-action="Index" asp-route-sortBy="newest">Hamısı →</a>
    </div>
    @if (Model.LatestProducts.Any())
    {
        <div class="sb-product-grid">
            @foreach (var p in Model.LatestProducts)
            {
                <partial name="_ProductCard" model="p" />
            }
        </div>
    }
    else
    {
        <div class="sb-empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
            <h3>Hələlik məhsul yoxdur</h3>
            <p>İlk satıcı sən ol və mağazanı bu gün başlat.</p>
            <a class="sb-btn sb-btn--primary" asp-controller="Account" asp-action="Register">Qeydiyyatdan keç</a>
        </div>
    }
</section>

@* ============== TRUST ============== *@
<section class="sb-section sb-reveal">
    <div class="sb-trust">
        <div class="sb-trust__item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
            <h3>Etibarlı mağazalar</h3>
            <p>Hər satıcı moderasiyadan keçir. Profil, ünvan və əlaqə məlumatları yoxlanılmışdır.</p>
        </div>
        <div class="sb-trust__item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            <h3>Yerli logistika</h3>
            <p>Yerli satıcılarla yerli çatdırılma — sürətli sifariş, az risk, az xərc.</p>
        </div>
        <div class="sb-trust__item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            <h3>Real rəylər</h3>
            <p>Şəkilli rəylər və 1–5 reytinq sistemi. Hər alıcı yalnız aldığı məhsula rəy verə bilir.</p>
        </div>
    </div>
</section>

@* ============== NEWSLETTER (real backend submission) ============== *@
<section class="sb-section sb-reveal">
    <div class="sb-newsletter">
        <span class="sb-eyebrow" style="color: rgba(255,255,255,.6);">Newsletter</span>
        <h2>Yeni gələnlərdən ilk sən xəbər tut</h2>
        <p>Endirimlər, xüsusi kolleksiyalar və satıcı hekayələri — ayda 1-2 dəfə, spam yoxdur.</p>
        <form id="sbNewsletterForm" novalidate>
            <input type="email" name="email" placeholder="E-mail ünvanın" aria-label="E-mail" required />
            <button type="submit" class="sb-btn sb-btn--accent">Abunə ol</button>
        </form>
        <div class="sb-newsletter__result" id="sbNewsletterResult" aria-live="polite"></div>
    </div>
</section>

@* ============== STORY VIEWER (built into page, hidden by default) ============== *@
<div class="sb-story-viewer" id="sbStoryViewer" aria-hidden="true" role="dialog">
    <div class="sb-story-viewer__frame">
        <div class="sb-story-viewer__progress" id="sbStoryProgress"></div>
        <div class="sb-story-viewer__header">
            <span class="sb-story-viewer__avatar" id="sbStoryAvatar"></span>
            <span class="sb-story-viewer__store-name" id="sbStoryStoreName"></span>
            <button class="sb-story-viewer__close" type="button" id="sbStoryClose" aria-label="Bağla">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <div class="sb-story-viewer__media">
            <img id="sbStoryImage" alt="" />
        </div>
        <div class="sb-story-viewer__caption" id="sbStoryCaption"></div>
        <div class="sb-story-viewer__tap sb-story-viewer__tap--prev" id="sbStoryTapPrev"></div>
        <div class="sb-story-viewer__tap sb-story-viewer__tap--next" id="sbStoryTapNext"></div>
    </div>
</div>
