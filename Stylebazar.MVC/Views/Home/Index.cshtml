@model HomeIndexViewModel
@{
    ViewData["Title"] = "Ana səhifə";
    ViewData["WishlistIds"] = Model.WishlistProductIds;
    var storiesJson = System.Text.Json.JsonSerializer.Serialize(Model.Stories);
}

@* ============== HERO — gradient with embedded search + stats ============== *@
<section class="sb-hero">
    <div class="sb-hero__blob sb-hero__blob--1" aria-hidden="true"></div>
    <div class="sb-hero__blob sb-hero__blob--2" aria-hidden="true"></div>

    <div class="sb-hero__inner">
        <div class="sb-hero__copy">
            <span class="sb-hero__eyebrow">Azərbaycan #1 geyim marketplace-i</span>
            <h1 class="sb-hero__title">
                Yerli mağazaları bir<br />
                <span class="sb-hero__title-accent">platformada</span> kəşf et
            </h1>
            <p class="sb-hero__sub">
                Minlərlə məhsul, onlarla mağaza — bəyəndiyinə birbaşa WhatsApp / Instagram ilə yaz.
                Sayt üzərində satınalma yox, sadəcə kəşf və əlaqə.
            </p>

            <form class="sb-hero__search" method="get" action="@Url.Action("Index", "Shop")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="search" name="search" placeholder="Köynək, çanta, ayaqqabı..." autocomplete="off" />
                <button type="submit">Axtar</button>
            </form>

            <div class="sb-hero__chips">
                <span class="sb-hero__chips-label">Populyar:</span>
                <a asp-controller="Shop" asp-action="Index" asp-route-search="koynek">Köynək</a>
                <a asp-controller="Shop" asp-action="Index" asp-route-search="ayaqqabi">Ayaqqabı</a>
                <a asp-controller="Shop" asp-action="Index" asp-route-search="canta">Çanta</a>
                <a asp-controller="Shop" asp-action="Index" asp-route-search="palto">Palto</a>
            </div>
        </div>

        <aside class="sb-hero__stats" aria-label="Statistika">
            <div class="sb-stat">
                <strong>@Model.TotalProductCount<span>+</span></strong>
                <span>Məhsul</span>
            </div>
            <div class="sb-stat">
                <strong>@Model.TotalStoreCount<span>+</span></strong>
                <span>Mağaza</span>
            </div>
            <div class="sb-stat">
                <strong>WhatsApp</strong>
                <span>Birbaşa əlaqə</span>
            </div>
        </aside>
    </div>
</section>

@* ============== FEATURED PRODUCTS — pastel mint rail ============== *@
<section class="sb-tile sb-tile--mint sb-reveal">
    <header class="sb-tile__head">
        <div>
            <span class="sb-tile__eyebrow">Editorlardan seçim</span>
            <h2>Seçilmiş məhsullar</h2>
        </div>
        <a asp-controller="Shop" asp-action="Index" asp-route-isFeatured="true" class="sb-tile__view-all">
            Hamısına bax
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
    </header>

    @if (Model.FeaturedProducts.Any())
    {
        <div class="sb-tile__rail-wrap">
            <button type="button" class="sb-tile__nav sb-tile__nav--prev" data-rail-prev aria-label="Sol">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <div class="sb-tile__rail" data-rail>
                @foreach (var p in Model.FeaturedProducts)
                {
                    <partial name="_ProductCard" model="p" />
                }
            </div>
            <button type="button" class="sb-tile__nav sb-tile__nav--next" data-rail-next aria-label="Sağ">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
        </div>
    }
    else
    {
        <div class="sb-tile__empty">
            <span>Tezliklə seçilmişlər burada görsənəcək.</span>
        </div>
    }
</section>

@* ============== CATEGORIES — bubble pills ============== *@
<section class="sb-tile sb-tile--cream sb-reveal">
    <header class="sb-tile__head">
        <div>
            <span class="sb-tile__eyebrow">Kəşf et</span>
            <h2>Kateqoriyalar</h2>
        </div>
        <a asp-controller="Shop" asp-action="Index" class="sb-tile__view-all">
            Hamısı
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
    </header>
    <div class="sb-cat-grid">
        @{
            var catIcons = new[]
            {
                "<path d='M3 9l1-5h16l1 5'/><path d='M5 9v11h14V9'/>",
                "<circle cx='12' cy='4.5' r='2.5'/><path d='M9 8l-2 4h10l-2-4'/><path d='M7 12l-2 9h14l-2-9'/>",
                "<path d='M9 3l3 2 3-2'/><path d='M9 3L4 6l2 4v11h12V10l2-4-5-3'/>",
                "<path d='M2 17l6-9 4 2 4-3 6 4v6H2z'/>",
                "<path d='M5 8h14l-1 13H6z'/><path d='M9 8V5a3 3 0 016 0v3'/>",
                "<path d='M6 3l-4 6 10 12L22 9l-4-6z'/>",
                "<rect x='3' y='3' width='18' height='18' rx='2'/>",
                "<polygon points='12 2 15 9 22 9 17 14 19 22 12 18 5 22 7 14 2 9 9 9 12 2'/>"
            };
            int i = 0;
        }
        @if (Model.Categories.Any())
        {
            @foreach (var c in Model.Categories.Take(8))
            {
                <a class="sb-cat-tile" asp-controller="Shop" asp-action="Index" asp-route-categoryId="@c.Id">
                    <span class="sb-cat-tile__icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(catIcons[i % catIcons.Length])</svg>
                    </span>
                    <span class="sb-cat-tile__name">@c.Name</span>
                </a>
                i++;
            }
        }
        else
        {
            <div class="sb-tile__empty"><span>Kateqoriyalar admin tərəfindən tezliklə əlavə olunacaq.</span></div>
        }
    </div>
</section>

@* ============== FEATURED STORES — shop showcase rail ============== *@
<section class="sb-tile sb-tile--lilac sb-reveal">
    <header class="sb-tile__head">
        <div>
            <span class="sb-tile__eyebrow">Tanınan satıcılar</span>
            <h2>Mağazalar</h2>
        </div>
        <a asp-controller="Store" asp-action="Index" class="sb-tile__view-all">
            Hamısı
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
    </header>

    @if (Model.FeaturedStores.Any())
    {
        <div class="sb-store-mini-grid">
            @foreach (var s in Model.FeaturedStores)
            {
                <a class="sb-store-mini" asp-controller="Store" asp-action="Detail" asp-route-slug="@s.Slug">
                    <span class="sb-store-mini__avatar">
                        @if (!string.IsNullOrEmpty(s.ProfileImageUrl))
                        {
                            <img src="@s.ProfileImageUrl" alt="@s.Name" loading="lazy" />
                        }
                        else
                        {
                            <span class="sb-store-mini__initial">@(s.Name.Length > 0 ? s.Name[0].ToString().ToUpper() : "S")</span>
                        }
                    </span>
                    <span class="sb-store-mini__body">
                        <strong>@s.Name</strong>
                        <span class="sb-store-mini__count">@s.ProductCount məhsul</span>
                    </span>
                    @if (s.ThumbnailImageUrls.Any())
                    {
                        <span class="sb-store-mini__thumbs">
                            @foreach (var url in s.ThumbnailImageUrls.Take(3))
                            {
                                <span class="sb-store-mini__thumb"><img src="@url" alt="" loading="lazy" /></span>
                            }
                        </span>
                    }
                </a>
            }
        </div>
    }
    else
    {
        <div class="sb-tile__empty"><span>İlk satıcılar tezliklə qoşulacaq.</span></div>
    }
</section>

@* ============== STORIES — pastel blush rail ============== *@
@if (Model.Stories.Any())
{
    <section class="sb-tile sb-tile--blush sb-reveal">
        <header class="sb-tile__head">
            <div>
                <span class="sb-tile__eyebrow">24 saatlıq</span>
                <h2>Hekayələr</h2>
            </div>
        </header>
        <div class="sb-stories-rail" id="sbStoriesRail">
            @foreach (var storeGroup in Model.Stories)
            {
                <button type="button" class="sb-story-item"
                        data-store-id="@storeGroup.StoreId"
                        data-store-name="@storeGroup.StoreName">
                    <span class="sb-story-item__ring">
                        <span class="sb-story-item__avatar">
                            @if (!string.IsNullOrEmpty(storeGroup.StoreProfileImageUrl))
                            {
                                <img src="@storeGroup.StoreProfileImageUrl" alt="@storeGroup.StoreName" loading="lazy" />
                            }
                            else
                            {
                                <span class="sb-story-item__initial">@(storeGroup.StoreName.Length > 0 ? storeGroup.StoreName[0].ToString().ToUpper() : "S")</span>
                            }
                        </span>
                    </span>
                    <span class="sb-story-item__name">@storeGroup.StoreName</span>
                </button>
            }
        </div>
    </section>
}

@* ============== LATEST PRODUCTS — mint grid ============== *@
<section class="sb-tile sb-tile--mint sb-reveal">
    <header class="sb-tile__head">
        <div>
            <span class="sb-tile__eyebrow">Yenilər</span>
            <h2>Son əlavələr</h2>
        </div>
        <a asp-controller="Shop" asp-action="Index" class="sb-tile__view-all">
            Hamısına bax
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
    </header>
    @if (Model.LatestProducts.Any())
    {
        <div class="sb-tile__grid">
            @foreach (var p in Model.LatestProducts)
            {
                <partial name="_ProductCard" model="p" />
            }
        </div>
    }
    else
    {
        <div class="sb-tile__empty"><span>İlk məhsullar tezliklə görünəcək.</span></div>
    }
</section>

@* ============== HOW IT WORKS — trust block ============== *@
<section class="sb-how sb-reveal">
    <header class="sb-how__head">
        <span class="sb-tile__eyebrow">Necə işləyir?</span>
        <h2>3 sadə addım</h2>
    </header>
    <div class="sb-how__steps">
        <div class="sb-how-step">
            <span class="sb-how-step__num">01</span>
            <div class="sb-how-step__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </div>
            <h3>Kəşf et</h3>
            <p>Yerli mağazaların kolleksiyalarına bax — kateqoriya, rəng, ölçü, brend üzrə filtrlə.</p>
        </div>
        <div class="sb-how-step">
            <span class="sb-how-step__num">02</span>
            <div class="sb-how-step__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
            </div>
            <h3>Bəyən və saxla</h3>
            <p>Hər bəyəndiyini wishlist-ə əlavə et — istədiyin vaxt qayıdıb yenidən tap.</p>
        </div>
        <div class="sb-how-step">
            <span class="sb-how-step__num">03</span>
            <div class="sb-how-step__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>
            </div>
            <h3>Satıcıya yaz</h3>
            <p>WhatsApp, Instagram və ya zəng — sayt üzərində ödəniş yox, birbaşa əlaqə.</p>
        </div>
    </div>
</section>

@* ============== NEWSLETTER ============== *@
<section class="sb-newsletter sb-reveal" aria-labelledby="sbNewsletterTitle">
    <div class="sb-newsletter__inner">
        <div>
            <span class="sb-eyebrow sb-eyebrow--light">Tezliklə</span>
            <h2 id="sbNewsletterTitle">Yeni kolleksiyalardan xəbərdar ol</h2>
            <p>Endirimlər və yeni satıcılar haqqında həftəlik məktub.</p>
        </div>
        <form class="sb-newsletter__form" id="sbNewsletterForm" novalidate>
            <input type="email" name="email" placeholder="sizin@email.az" required />
            <button type="submit">
                <span>Abunə ol</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </button>
            <div class="sb-newsletter__result" data-newsletter-result aria-live="polite"></div>
        </form>
    </div>
</section>

@* ============== STORY VIEWER MODAL ============== *@
<div class="sb-story-viewer" id="sbStoryViewer" aria-hidden="true">
    <button type="button" class="sb-story-viewer__close" data-story-close aria-label="Bağla">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div class="sb-story-viewer__frame">
        <div class="sb-story-viewer__progress" data-story-progress></div>
        <header class="sb-story-viewer__head">
            <span class="sb-story-viewer__avatar" data-story-avatar></span>
            <span class="sb-story-viewer__store" data-story-store></span>
        </header>
        <img class="sb-story-viewer__img" data-story-img alt="" />
        <span class="sb-story-viewer__caption" data-story-caption></span>
        <button type="button" class="sb-story-viewer__tap sb-story-viewer__tap--prev" data-story-prev aria-label="Əvvəlki"></button>
        <button type="button" class="sb-story-viewer__tap sb-story-viewer__tap--next" data-story-next aria-label="Növbəti"></button>
    </div>
</div>

@section Scripts {
    <script id="sbStoriesData" type="application/json">@Html.Raw(storiesJson)</script>
}
