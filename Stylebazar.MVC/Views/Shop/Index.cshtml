@using Stylebazar.DAL.Entities.Enums
@model ShopIndexViewModel
@{
    ViewData["Title"] = "Mağaza";
    var q = Model.Query;
    // Published for _ProductCard so each card can paint its initial heart state.
    ViewData["WishlistIds"] = Model.WishlistProductIds;
}

@functions {
    string SortLabel(string? key) => key switch
    {
        "price-asc" => "Qiymət: ucuz → baha",
        "price-desc" => "Qiymət: baha → ucuz",
        "name-asc" => "Ad: A → Z",
        "name-desc" => "Ad: Z → A",
        _ => "Ən yeni"
    };
}

<header class="sb-shop__header">
    <span class="sb-eyebrow">StyleBazar</span>
    <h1>Mağaza</h1>
    <p>Yerli satıcılardan brend geyimləri kəşf et.</p>
</header>

<div class="sb-shop">

    @* ============== FILTER SIDEBAR (form GET) ============== *@
    <aside class="sb-filter" id="sbShopFilter">
        <form method="get" asp-action="Index" id="sbShopFilterForm">
            <div class="sb-filter__head">
                <h3>Filtrlər</h3>
                <button type="button" class="sb-filter__close" id="sbFilterClose" aria-label="Bağla">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>

            <input type="hidden" name="sortBy" value="@q.SortBy" />

            <div class="sb-filter-group">
                <h4>Axtarış</h4>
                <input type="search" class="sb-filter-search" name="search" value="@q.Search" placeholder="Məhsul axtar..." />
            </div>

            @if (Model.Categories.Any())
            {
                <div class="sb-filter-group">
                    <h4>Kateqoriya</h4>
                    <label class="sb-filter-option">
                        <input type="radio" name="categoryId" value=""
                               checked="@(!q.CategoryId.HasValue)" />
                        <span class="sb-filter-option__box"></span>
                        <span>Hamısı</span>
                    </label>
                    @foreach (var cat in Model.Categories.Take(15))
                    {
                        <label class="sb-filter-option">
                            <input type="radio" name="categoryId" value="@cat.Id"
                                   checked="@(q.CategoryId == cat.Id)" />
                            <span class="sb-filter-option__box"></span>
                            <span>@cat.Name</span>
                        </label>
                    }
                </div>
            }

            <div class="sb-filter-group">
                <h4>Qiymət (₼)</h4>
                <div class="sb-filter-price">
                    <input type="number" min="0" step="1" name="minPrice" value="@(q.MinPrice?.ToString("F0") ?? "")" placeholder="Min" />
                    <input type="number" min="0" step="1" name="maxPrice" value="@(q.MaxPrice?.ToString("F0") ?? "")" placeholder="Max" />
                </div>
            </div>

            <div class="sb-filter-group">
                <h4>Vəziyyət</h4>
                <label class="sb-filter-option">
                    <input type="radio" name="condition" value=""
                           checked="@(!q.Condition.HasValue)" />
                    <span class="sb-filter-option__box"></span>
                    <span>Hamısı</span>
                </label>
                <label class="sb-filter-option">
                    <input type="radio" name="condition" value="New"
                           checked="@(q.Condition == ProductCondition.New)" />
                    <span class="sb-filter-option__box"></span>
                    <span>Yeni</span>
                </label>
                <label class="sb-filter-option">
                    <input type="radio" name="condition" value="SecondHand"
                           checked="@(q.Condition == ProductCondition.SecondHand)" />
                    <span class="sb-filter-option__box"></span>
                    <span>İkinci əl</span>
                </label>
                <label class="sb-filter-option">
                    <input type="radio" name="condition" value="Vintage"
                           checked="@(q.Condition == ProductCondition.Vintage)" />
                    <span class="sb-filter-option__box"></span>
                    <span>Vintage</span>
                </label>
            </div>

            @if (Model.Brands.Any())
            {
                <div class="sb-filter-group">
                    <h4>Brend</h4>
                    <label class="sb-filter-option">
                        <input type="radio" name="brand" value=""
                               checked="@(string.IsNullOrEmpty(q.Brand))" />
                        <span class="sb-filter-option__box"></span>
                        <span>Hamısı</span>
                    </label>
                    @foreach (var b in Model.Brands.Take(10))
                    {
                        <label class="sb-filter-option">
                            <input type="radio" name="brand" value="@b"
                                   checked="@(q.Brand == b)" />
                            <span class="sb-filter-option__box"></span>
                            <span>@b</span>
                        </label>
                    }
                </div>
            }

            <div class="sb-filter-group">
                <h4>Featured</h4>
                <label class="sb-filter-option">
                    <input type="checkbox" name="isFeatured" value="true"
                           checked="@(q.IsFeatured == true)" />
                    <span class="sb-filter-option__box">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    </span>
                    <span>Yalnız önə çıxanlar</span>
                </label>
            </div>

            <div class="sb-filter__actions">
                <button type="submit" class="sb-btn sb-btn--primary sb-btn--sm">Tətbiq et</button>
                <a class="sb-btn sb-btn--ghost sb-btn--sm" asp-action="Index">Sıfırla</a>
            </div>
        </form>
    </aside>

    @* Mobile backdrop *@
    <div class="sb-filter-backdrop" id="sbFilterBackdrop" aria-hidden="true"></div>

    @* ============== MAIN (toolbar + chips + grid + paging) ============== *@
    <div>
        @* Top toolbar *@
        <div class="sb-toolbar">
            <span class="sb-toolbar__count">
                <strong>@Model.Products.Count</strong> nəticə
                @if (!string.IsNullOrEmpty(q.Search)) { <text>— "<strong>@q.Search</strong>" üçün</text> }
            </span>
            <div class="sb-toolbar__right">
                <button type="button" class="sb-mobile-filter-btn" id="sbFilterOpen">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><line x1="4" y1="6" x2="20" y2="6"/><line x1="7" y1="12" x2="17" y2="12"/><line x1="10" y1="18" x2="14" y2="18"/></svg>
                    Filtr
                </button>
                <select class="sb-sort-select" id="sbShopSort">
                    <option value="" selected="@(string.IsNullOrEmpty(q.SortBy))">Ən yeni</option>
                    <option value="price-asc" selected="@(q.SortBy == "price-asc")">Qiymət ↑</option>
                    <option value="price-desc" selected="@(q.SortBy == "price-desc")">Qiymət ↓</option>
                    <option value="name-asc" selected="@(q.SortBy == "name-asc")">Ad: A → Z</option>
                    <option value="name-desc" selected="@(q.SortBy == "name-desc")">Ad: Z → A</option>
                </select>
            </div>
        </div>

        @* Active filter chips *@
        @{
            bool hasAnyFilter =
                !string.IsNullOrEmpty(q.Search)
                || q.CategoryId.HasValue
                || !string.IsNullOrEmpty(q.Brand)
                || q.MinPrice.HasValue || q.MaxPrice.HasValue
                || q.Condition.HasValue
                || q.IsFeatured == true;
        }
        @if (hasAnyFilter)
        {
            <div class="sb-chips-row">
                @if (!string.IsNullOrEmpty(q.Search))
                {
                    <span class="sb-chip">"@q.Search"
                        <a asp-action="Index" asp-route-categoryId="@q.CategoryId" asp-route-brand="@q.Brand" asp-route-minPrice="@q.MinPrice" asp-route-maxPrice="@q.MaxPrice" asp-route-condition="@q.Condition" asp-route-sortBy="@q.SortBy">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        </a>
                    </span>
                }
                @if (q.CategoryId.HasValue)
                {
                    var catName = Model.Categories.FirstOrDefault(c => c.Id == q.CategoryId.Value)?.Name ?? $"#{q.CategoryId}";
                    <span class="sb-chip">@catName
                        <a asp-action="Index" asp-route-search="@q.Search" asp-route-brand="@q.Brand" asp-route-minPrice="@q.MinPrice" asp-route-maxPrice="@q.MaxPrice" asp-route-condition="@q.Condition" asp-route-sortBy="@q.SortBy">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        </a>
                    </span>
                }
                @if (!string.IsNullOrEmpty(q.Brand))
                {
                    <span class="sb-chip">@q.Brand
                        <a asp-action="Index" asp-route-search="@q.Search" asp-route-categoryId="@q.CategoryId" asp-route-minPrice="@q.MinPrice" asp-route-maxPrice="@q.MaxPrice" asp-route-condition="@q.Condition" asp-route-sortBy="@q.SortBy">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        </a>
                    </span>
                }
                @if (q.MinPrice.HasValue || q.MaxPrice.HasValue)
                {
                    var label = $"{q.MinPrice?.ToString("F0") ?? "0"} – {q.MaxPrice?.ToString("F0") ?? "∞"} ₼";
                    <span class="sb-chip">@label
                        <a asp-action="Index" asp-route-search="@q.Search" asp-route-categoryId="@q.CategoryId" asp-route-brand="@q.Brand" asp-route-condition="@q.Condition" asp-route-sortBy="@q.SortBy">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        </a>
                    </span>
                }
                @if (q.Condition.HasValue)
                {
                    var cLabel = q.Condition.Value switch { ProductCondition.SecondHand => "İkinci əl", ProductCondition.Vintage => "Vintage", _ => "Yeni" };
                    <span class="sb-chip">@cLabel
                        <a asp-action="Index" asp-route-search="@q.Search" asp-route-categoryId="@q.CategoryId" asp-route-brand="@q.Brand" asp-route-minPrice="@q.MinPrice" asp-route-maxPrice="@q.MaxPrice" asp-route-sortBy="@q.SortBy">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        </a>
                    </span>
                }
                @if (q.IsFeatured == true)
                {
                    <span class="sb-chip">Önə çıxan
                        <a asp-action="Index" asp-route-search="@q.Search" asp-route-categoryId="@q.CategoryId" asp-route-brand="@q.Brand" asp-route-minPrice="@q.MinPrice" asp-route-maxPrice="@q.MaxPrice" asp-route-condition="@q.Condition" asp-route-sortBy="@q.SortBy">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        </a>
                    </span>
                }
                <a class="sb-chip sb-chip--clear" asp-action="Index">Hamısını sıfırla</a>
            </div>
        }

        @* Product grid or empty state *@
        @if (Model.Products.Count == 0)
        {
            <div class="sb-empty">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <h3>Heç bir məhsul tapılmadı</h3>
                <p>Filtri dəyiş, daha geniş axtarış et və ya hamısını sıfırla.</p>
                <a class="sb-btn sb-btn--primary" asp-action="Index">Hamısını göstər</a>
            </div>
        }
        else
        {
            <div class="sb-product-grid">
                @foreach (var p in Model.Products.Items)
                {
                    <partial name="_ProductCard" model="p" />
                }
            </div>

            @* Pagination *@
            @if (Model.Products.Pages > 1)
            {
                <nav class="sb-pagination" aria-label="Səhifələmə">
                    @{
                        int currentPage = Model.Products.Index + 1; // 1-based
                        int totalPages = Model.Products.Pages;
                        int from = Math.Max(1, currentPage - 2);
                        int to = Math.Min(totalPages, currentPage + 2);
                    }
                    @if (Model.Products.HasPrevious)
                    {
                        <a class="sb-pagination__item"
                           asp-action="Index"
                           asp-route-page="@(currentPage - 1)"
                           asp-route-search="@q.Search" asp-route-categoryId="@q.CategoryId" asp-route-brand="@q.Brand"
                           asp-route-minPrice="@q.MinPrice" asp-route-maxPrice="@q.MaxPrice"
                           asp-route-condition="@q.Condition" asp-route-isFeatured="@q.IsFeatured" asp-route-sortBy="@q.SortBy"
                           aria-label="Əvvəlki">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="15 18 9 12 15 6"/></svg>
                        </a>
                    }
                    else
                    {
                        <span class="sb-pagination__item is-disabled"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="15 18 9 12 15 6"/></svg></span>
                    }

                    @if (from > 1)
                    {
                        <a class="sb-pagination__item" asp-action="Index"
                           asp-route-page="1"
                           asp-route-search="@q.Search" asp-route-categoryId="@q.CategoryId" asp-route-brand="@q.Brand"
                           asp-route-minPrice="@q.MinPrice" asp-route-maxPrice="@q.MaxPrice"
                           asp-route-condition="@q.Condition" asp-route-isFeatured="@q.IsFeatured" asp-route-sortBy="@q.SortBy">1</a>
                        @if (from > 2) { <span class="sb-pagination__gap">…</span> }
                    }

                    @for (int i = from; i <= to; i++)
                    {
                        if (i == currentPage)
                        {
                            <span class="sb-pagination__item is-active">@i</span>
                        }
                        else
                        {
                            <a class="sb-pagination__item" asp-action="Index"
                               asp-route-page="@i"
                               asp-route-search="@q.Search" asp-route-categoryId="@q.CategoryId" asp-route-brand="@q.Brand"
                               asp-route-minPrice="@q.MinPrice" asp-route-maxPrice="@q.MaxPrice"
                               asp-route-condition="@q.Condition" asp-route-isFeatured="@q.IsFeatured" asp-route-sortBy="@q.SortBy">@i</a>
                        }
                    }

                    @if (to < totalPages)
                    {
                        @if (to < totalPages - 1) { <span class="sb-pagination__gap">…</span> }
                        <a class="sb-pagination__item" asp-action="Index"
                           asp-route-page="@totalPages"
                           asp-route-search="@q.Search" asp-route-categoryId="@q.CategoryId" asp-route-brand="@q.Brand"
                           asp-route-minPrice="@q.MinPrice" asp-route-maxPrice="@q.MaxPrice"
                           asp-route-condition="@q.Condition" asp-route-isFeatured="@q.IsFeatured" asp-route-sortBy="@q.SortBy">@totalPages</a>
                    }

                    @if (Model.Products.HasNext)
                    {
                        <a class="sb-pagination__item"
                           asp-action="Index"
                           asp-route-page="@(currentPage + 1)"
                           asp-route-search="@q.Search" asp-route-categoryId="@q.CategoryId" asp-route-brand="@q.Brand"
                           asp-route-minPrice="@q.MinPrice" asp-route-maxPrice="@q.MaxPrice"
                           asp-route-condition="@q.Condition" asp-route-isFeatured="@q.IsFeatured" asp-route-sortBy="@q.SortBy"
                           aria-label="Növbəti">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="9 18 15 12 9 6"/></svg>
                        </a>
                    }
                    else
                    {
                        <span class="sb-pagination__item is-disabled"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="9 18 15 12 9 6"/></svg></span>
                    }
                </nav>
            }
        }
    </div>
</div>
