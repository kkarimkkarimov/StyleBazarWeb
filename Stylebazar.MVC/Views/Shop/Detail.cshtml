@using Stylebazar.DAL.Entities.Enums
@model ShopDetailViewModel
@{
    ViewData["Title"] = Model.Product.Name;
    // Published so the related-rail _ProductCard partials paint correct hearts.
    ViewData["WishlistIds"] = Model.WishlistProductIds;
    var p = Model.Product;
    bool isAuth = User.Identity?.IsAuthenticated == true;
    var mainImg = p.Images.OrderByDescending(i => i.IsMain).ThenBy(i => i.DisplayOrder).FirstOrDefault();
    var hasDiscount = p.DiscountPrice.HasValue && p.DiscountPrice.Value < p.Price;
    var savePct = hasDiscount ? (int)Math.Round(((double)(p.Price - p.DiscountPrice!.Value) / (double)p.Price) * 100) : 0;
    var stockLevel = p.StockQuantity <= 0 ? "out" : p.StockQuantity < 5 ? "low" : "ok";
    var avg = p.AverageRating;
    var fullStars = (int)Math.Floor(avg);
    var hasHalf = avg - fullStars >= 0.5;

    // Lightbox payload — all images for prev/next navigation
    var lightboxJson = System.Text.Json.JsonSerializer.Serialize(
        p.Images.OrderByDescending(i => i.IsMain).ThenBy(i => i.DisplayOrder)
            .Select(i => new { url = i.ImageUrl, alt = p.Name })
            .ToList());
}

<nav class="sb-breadcrumb" aria-label="Breadcrumb">
    <a asp-controller="Home" asp-action="Index">Ana səhifə</a>
    <span class="sb-breadcrumb__sep" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="9 18 15 12 9 6"/></svg>
    </span>
    <a asp-controller="Shop" asp-action="Index">Mağaza</a>
    <span class="sb-breadcrumb__sep" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="9 18 15 12 9 6"/></svg>
    </span>
    <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@p.CategoryId">@p.CategoryName</a>
    <span class="sb-breadcrumb__sep" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><polyline points="9 18 15 12 9 6"/></svg>
    </span>
    <span class="sb-breadcrumb__current">@p.Name</span>
</nav>

<section class="sb-product-detail" data-product-id="@p.Id">

    @* ============== GALLERY (left) ============== *@
    <div class="sb-gallery" data-gallery>
        <div class="sb-gallery__main" data-gallery-main role="button" tabindex="0" aria-label="Şəkli böyüt">
            @if (mainImg != null)
            {
                <img id="sbGalleryMainImg" src="@mainImg.ImageUrl" alt="@p.Name" data-main-img />
            }
            else
            {
                <div class="sb-gallery__fallback">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                </div>
            }
            <span class="sb-gallery__zoom-hint" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
                Böyüt
            </span>
        </div>

        @if (p.Images.Count > 1)
        {
            <div class="sb-gallery__thumbs" data-gallery-thumbs role="tablist">
                @{ var idx = 0; }
                @foreach (var img in p.Images.OrderByDescending(i => i.IsMain).ThenBy(i => i.DisplayOrder))
                {
                    <button type="button"
                            class="sb-gallery__thumb @(idx == 0 ? "is-active" : "")"
                            data-thumb-index="@idx"
                            data-thumb-url="@img.ImageUrl"
                            role="tab"
                            aria-label="Şəkil @(idx + 1)">
                        <img src="@img.ImageUrl" alt="@p.Name" loading="lazy" />
                    </button>
                    idx++;
                }
            </div>
        }
    </div>

    @* ============== INFO (right) ============== *@
    <div class="sb-info">

        @* Badges *@
        <div class="sb-info__badges">
            @if (p.IsFeatured)
            {
                <span class="sb-info__badge sb-info__badge--accent">Featured</span>
            }
            @if (hasDiscount)
            {
                <span class="sb-info__badge sb-info__badge--dark">-@savePct%</span>
            }
            @if (p.Condition == ProductCondition.SecondHand)
            {
                <span class="sb-info__badge sb-info__badge--soft">İkinci əl</span>
            }
            else if (p.Condition == ProductCondition.Vintage)
            {
                <span class="sb-info__badge sb-info__badge--soft">Vintage</span>
            }
        </div>

        <h1 class="sb-info__title">@p.Name</h1>

        @* Store row *@
        <div class="sb-info__store-row">
            <span>Satıcı:</span>
            <a href="#" title="@p.StoreName">@p.StoreName</a>
            @if (!string.IsNullOrWhiteSpace(p.Brand))
            {
                <span class="sb-dot" aria-hidden="true"></span>
                <span>Brend: <strong style="color: var(--sb-ink); font-weight: 500;">@p.Brand</strong></span>
            }
        </div>

        @* Rating *@
        <div class="sb-info__rating">
            <span class="sb-info__rating-stars" aria-label="Reytinq: @avg.ToString("F1") / 5">
                @for (var i = 1; i <= 5; i++)
                {
                    var filled = i <= fullStars || (i == fullStars + 1 && hasHalf);
                    <svg class="@(filled ? "" : "is-empty")" viewBox="0 0 24 24" fill="currentColor">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                    </svg>
                }
            </span>
            @if (p.ReviewCount > 0)
            {
                <span class="sb-info__rating-value">@avg.ToString("F1")</span>
                <span class="sb-info__rating-count">·</span>
                <span class="sb-info__rating-count">
                    <a href="#sbReviews">@p.ReviewCount rəy</a>
                </span>
            }
            else
            {
                <span class="sb-info__rating-count">Hələ rəy yoxdur</span>
            }
        </div>

        @* Price *@
        <div class="sb-info__price">
            @if (hasDiscount)
            {
                <span class="sb-info__price-now sb-info__price-now--accent">@p.DiscountPrice!.Value.ToString("N2") ₼</span>
                <span class="sb-info__price-old">@p.Price.ToString("N2") ₼</span>
                <span class="sb-info__price-save">-@savePct%</span>
            }
            else
            {
                <span class="sb-info__price-now">@p.Price.ToString("N2") ₼</span>
            }
        </div>

        @* Stock status *@
        <div class="sb-info__stock @(stockLevel == "low" ? "sb-info__stock--low" : "") @(stockLevel == "out" ? "sb-info__stock--out" : "")">
            <span class="sb-info__stock-dot" aria-hidden="true"></span>
            @if (stockLevel == "out")
            {
                <span>Stokda yoxdur</span>
            }
            else if (stockLevel == "low")
            {
                <span>Yalnız <strong>@p.StockQuantity</strong> ədəd qaldı — tələs!</span>
            }
            else
            {
                <span>Stokdadır — @p.StockQuantity ədəd</span>
            }
        </div>

        @* Size picker *@
        @if (p.Sizes.Any())
        {
            <div>
                <div class="sb-info-row" style="margin-bottom: 10px;">
                    <span class="sb-info-row__label">Ölçü</span>
                    <span class="sb-info-row__value" id="sbSizeLabel" style="color: var(--sb-muted);">Ölçü seçin</span>
                </div>
                <div class="sb-size-picker" data-size-picker>
                    @foreach (var sz in p.Sizes)
                    {
                        <button type="button"
                                class="sb-size-chip"
                                data-size-value="@sz.Size"
                                data-size-stock="@sz.StockQuantity"
                                @(sz.StockQuantity <= 0 ? "disabled" : "")>
                            @sz.Size
                        </button>
                    }
                </div>
            </div>
        }

        @* Quantity + Actions *@
        <div class="sb-info-row">
            <span class="sb-info-row__label">Miqdar</span>
            <span class="sb-info-row__value">
                <div class="sb-qty" data-qty data-max="@p.StockQuantity">
                    <button type="button" class="sb-qty__btn" data-qty-dec aria-label="Azalt">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    </button>
                    <input type="number" class="sb-qty__input" value="1" min="1" max="@Math.Max(1, p.StockQuantity)" data-qty-input />
                    <button type="button" class="sb-qty__btn" data-qty-inc aria-label="Artır">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    </button>
                </div>
            </span>
        </div>

        <div class="sb-detail-actions">
            <button type="button" class="sb-btn-cart" data-add-to-cart @(stockLevel == "out" ? "disabled" : "")>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/></svg>
                @if (stockLevel == "out")
                {
                    <span>Stokda yoxdur</span>
                }
                else
                {
                    <span>Səbətə əlavə et</span>
                }
            </button>
            <button type="button"
                    class="sb-btn-wish-lg @(Model.IsInWishlist ? "is-active" : "")"
                    data-product-id="@p.Id"
                    data-wish-toggle
                    aria-pressed="@(Model.IsInWishlist ? "true" : "false")"
                    aria-label="Wishlist-ə əlavə et">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
            </button>
        </div>

        @* Description *@
        @if (!string.IsNullOrWhiteSpace(p.Description))
        {
            <div class="sb-info__description">
                <h3>Məhsul haqqında</h3>
                <p>@p.Description</p>
            </div>
        }

        @* Trust block *@
        <div class="sb-detail-trust">
            <div class="sb-detail-trust__item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="1"/><path d="M16 8h4l3 3v5h-7"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                <div>
                    <strong>Sürətli çatdırılma</strong>
                    Bakı daxili 1-2 gün
                </div>
            </div>
            <div class="sb-detail-trust__item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"/><path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
                <div>
                    <strong>Geri qaytarma</strong>
                    14 gün ərzində
                </div>
            </div>
            <div class="sb-detail-trust__item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                <div>
                    <strong>Təhlükəsiz ödəniş</strong>
                    SSL şifrələnmə
                </div>
            </div>
        </div>
    </div>
</section>

@* ============== REVIEWS ============== *@
<section class="sb-reviews" id="sbReviews">

    @* ========== REVIEW AUTHORING ZONE (top of reviews block) ========== *@
    @if (Model.MyReview is not null)
    {
        var mr = Model.MyReview;
        <div class="sb-my-review" data-my-review data-review-id="@mr.Id">
            <header class="sb-my-review__head">
                <span class="sb-my-review__pill">Sənin rəyin</span>
                <div class="sb-my-review__head-right">
                    <button type="button" class="sb-my-review__action" data-my-review-edit aria-label="Rəyi redaktə et">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        <span>Redaktə et</span>
                    </button>
                    <button type="button" class="sb-my-review__action sb-my-review__action--danger" data-my-review-delete aria-label="Rəyi sil">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
                        <span>Sil</span>
                    </button>
                </div>
            </header>
            <div class="sb-my-review__stars" aria-label="Sənin reytinqin: @mr.Rating / 5">
                @for (var i = 1; i <= 5; i++)
                {
                    <svg class="@(i <= mr.Rating ? "" : "is-empty")" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(mr.Comment))
            {
                <p class="sb-my-review__comment">@mr.Comment</p>
            }
            <span class="sb-my-review__date">@mr.CreatedDate.ToString("dd MMM yyyy")</span>
        </div>
    }
    else if (isAuth)
    {
        @* Inline review form — collapsible to keep the section calm by default *@
        <div class="sb-review-form" data-review-form data-product-id="@p.Id">
            <button type="button" class="sb-review-form__toggle" data-review-form-toggle aria-expanded="false">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <span>Rəy yaz</span>
            </button>
            <form class="sb-review-form__body" data-review-form-body novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@p.Id" />

                <div class="sb-review-form__row">
                    <label class="sb-review-form__label">Reytinqin</label>
                    <div class="sb-rating-input" data-rating-input role="radiogroup" aria-label="Ulduzla qiymətləndir">
                        @for (var i = 1; i <= 5; i++)
                        {
                            <button type="button"
                                    class="sb-rating-input__star"
                                    data-rating-value="@i"
                                    role="radio"
                                    aria-checked="false"
                                    aria-label="@i ulduz">
                                <svg viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                            </button>
                        }
                        <input type="hidden" name="rating" value="0" data-rating-value-input required />
                        <span class="sb-rating-input__hint" data-rating-hint>Ulduz seç</span>
                    </div>
                </div>

                <div class="sb-review-form__row">
                    <label class="sb-review-form__label" for="sbReviewComment">Şərh <span class="sb-muted">(istəyə bağlı)</span></label>
                    <textarea id="sbReviewComment"
                              class="sb-review-form__textarea"
                              name="comment"
                              rows="4"
                              maxlength="1000"
                              placeholder="Məhsul haqqında düşüncələrini bizimlə bölüş..."
                              data-review-textarea></textarea>
                    <span class="sb-review-form__counter" data-review-counter>0 / 1000</span>
                </div>

                <div class="sb-review-form__row sb-review-form__row--inline">
                    <label class="sb-btn-upload" data-review-image-label>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                        <span>Şəkil əlavə et</span>
                        <input type="file" accept="image/*" multiple hidden data-review-image-input />
                    </label>
                    <span class="sb-review-form__hint">Maks 3 şəkil, hər biri 10 MB-a qədər</span>
                </div>
                <div class="sb-review-form__previews" data-review-previews></div>

                <div class="sb-review-form__error" data-review-error hidden></div>

                <div class="sb-review-form__actions">
                    <button type="button" class="sb-btn-ghost" data-review-form-cancel>Ləğv et</button>
                    <button type="submit" class="sb-btn-primary" data-review-submit>
                        <span>Rəyi göndər</span>
                    </button>
                </div>
            </form>
        </div>
    }
    else
    {
        <div class="sb-review-cta">
            <div>
                <strong>Bu məhsulu sınamısan?</strong>
                <p>Rəy yazmaq üçün hesabına daxil ol.</p>
            </div>
            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Detail", "Shop", new { id = p.Id })#sbReviews" class="sb-btn-primary">
                Daxil ol
            </a>
        </div>
    }

    <div class="sb-reviews__header">
        <h2>@(Model.MyReview is not null ? "Digər rəylər" : "Rəylər")</h2>
        @if (Model.Reviews.Items.Any())
        {
            <div class="sb-reviews__summary">
                <span class="sb-info__rating-stars" aria-hidden="true">
                    @for (var i = 1; i <= 5; i++)
                    {
                        var filled = i <= fullStars || (i == fullStars + 1 && hasHalf);
                        <svg class="@(filled ? "" : "is-empty")" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    }
                </span>
                <span class="sb-reviews__summary-value">@avg.ToString("F1")</span>
                <span>(@p.ReviewCount rəy)</span>
            </div>
        }
    </div>

    @if (Model.Reviews.Items.Any())
    {
        <div class="sb-reviews__list">
            @foreach (var r in Model.Reviews.Items)
            {
                var initial = string.IsNullOrWhiteSpace(r.UserFullName) ? "?" : r.UserFullName.Trim()[0].ToString();
                <article class="sb-review">
                    <div class="sb-review__avatar">
                        @if (!string.IsNullOrEmpty(r.UserProfileImageUrl))
                        {
                            <img src="@r.UserProfileImageUrl" alt="@r.UserFullName" loading="lazy" />
                        }
                        else
                        {
                            @initial
                        }
                    </div>
                    <div class="sb-review__body">
                        <div class="sb-review__head">
                            <span class="sb-review__name">@r.UserFullName</span>
                            <span class="sb-review__stars" aria-label="Reytinq: @r.Rating / 5">
                                @for (var i = 1; i <= 5; i++)
                                {
                                    <svg class="@(i <= r.Rating ? "" : "is-empty")" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                                }
                            </span>
                            <span class="sb-review__date">@r.CreatedDate.ToString("dd MMM yyyy")</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(r.Comment))
                        {
                            <p class="sb-review__comment">@r.Comment</p>
                        }
                        @if (r.Images.Any())
                        {
                            <div class="sb-review__images">
                                @foreach (var img in r.Images)
                                {
                                    <button type="button" class="sb-review__image" data-review-image="@img.ImageUrl" aria-label="Şəkli aç">
                                        <img src="@img.ImageUrl" alt="Rəy şəkli" loading="lazy" />
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </article>
            }
        </div>

        @if (Model.Reviews.Pages > 1)
        {
            <p style="margin-top: 24px; color: var(--sb-muted); font-size: .88rem;">
                @Model.Reviews.Items.Count / @Model.Reviews.Count rəy göstərilir
            </p>
        }
    }
    else if (Model.MyReview is null)
    {
        <div class="sb-reviews__empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
            <strong>Hələ rəy yoxdur</strong>
            <span>Bu məhsulun ilk rəyini sən yaz!</span>
        </div>
    }
</section>

@* ============== RELATED FROM SAME STORE ============== *@
@if (Model.RelatedFromStore.Any())
{
    <section class="sb-detail-related">
        <div class="sb-detail-related__header">
            <h2>Daha çox <span style="color: var(--sb-accent);">@p.StoreName</span> mağazasından</h2>
            <a asp-controller="Shop" asp-action="Index">
                Hamısına bax
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
        </div>
        <div class="sb-detail-related__grid">
            @foreach (var rel in Model.RelatedFromStore)
            {
                <partial name="_ProductCard" model="rel" />
            }
        </div>
    </section>
}

@* ============== LIGHTBOX ============== *@
<div class="sb-lightbox" id="sbLightbox" role="dialog" aria-hidden="true" aria-label="Şəkil baxışı">
    <button type="button" class="sb-lightbox__close" data-lightbox-close aria-label="Bağla">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div class="sb-lightbox__stage">
        <button type="button" class="sb-lightbox__nav sb-lightbox__nav--prev" data-lightbox-prev aria-label="Əvvəlki">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <img id="sbLightboxImg" class="sb-lightbox__img" src="" alt="" />
        <button type="button" class="sb-lightbox__nav sb-lightbox__nav--next" data-lightbox-next aria-label="Növbəti">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
        <span class="sb-lightbox__counter" id="sbLightboxCounter">1 / @p.Images.Count</span>
    </div>
</div>

@section Scripts {
    <script id="sbLightboxData" type="application/json">@Html.Raw(lightboxJson)</script>
}
