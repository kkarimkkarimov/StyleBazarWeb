@model string
@{
    ViewData["Title"] = L["Linki email-də yoxla"].Value;
}

<div class="sb-auth">
    <div class="sb-auth__form-wrap">
        <div class="sb-auth__form sb-auth__form--centered">
            <div class="sb-auth__icon-circle">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>

            <h1>@L["Email-i"] <em>@L["yoxla."]</em></h1>
            <p class="sb-auth__form-sub">
                @L["Əgər"] <strong>@(string.IsNullOrEmpty(Model) ? L["yazdığın"].Value : Model)</strong> @L["ünvanı hesabımıza bağlıdırsa, bərpa linkini göndərdik. Linkə klikləyib yeni parolunu təyin et — link 24 saatlıqdır."]
            </p>

            <div class="sb-auth__alt sb-auth__alt--row">
                <a asp-action="Login" class="sb-btn sb-btn--primary sb-btn--block">@L["Girişə qayıt"]</a>
            </div>

            <p class="sb-auth__hint">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                @L["Email gəlmədi? Spam qovluğunu yoxla və ya bir neçə dəqiqə sonra"]
                <a asp-action="ForgotPassword">@L["Retry.Again"]</a> @L["cəhd et."]
            </p>
        </div>
    </div>

    <aside class="sb-auth__panel">
        <div class="sb-auth__panel-top">
            <span class="sb-auth__panel-eyebrow">StyleBazar</span>
            <h2 class="sb-auth__panel-quote">"@L["Bir az gözlə — yeni paroluna sahib olmağa az qaldı."]"</h2>
        </div>
    </aside>
</div>
