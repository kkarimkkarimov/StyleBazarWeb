@model ForgotPasswordViewModel
@{
    ViewData["Title"] = L["Parolu bərpa et"].Value;
}

<div class="sb-auth">
    <div class="sb-auth__form-wrap">
        <form class="sb-auth__form" asp-action="ForgotPassword" method="post" novalidate data-auth-form>
            @Html.AntiForgeryToken()

            <h1>@L["Parolu"] <em>@L["bərpa et."]</em></h1>
            <p class="sb-auth__form-sub">@L["Email ünvanını yaz — bərpa linkini sənə göndəririk."]</p>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""]?.Errors.Count > 0)
            {
                <div class="sb-form-summary">
                    @foreach (var err in ViewData.ModelState[""]!.Errors) { @err.ErrorMessage <br /> }
                </div>
            }

            <div class="sb-field">
                <label class="sb-field__label" asp-for="Email">@L["Email"]</label>
                <input class="sb-field__input @(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "is-error" : "")"
                       asp-for="Email"
                       type="email"
                       placeholder="sen@example.com"
                       autocomplete="email"
                       autofocus />
                <span class="sb-field__error" asp-validation-for="Email"></span>
            </div>

            <button type="submit" class="sb-btn sb-btn--primary sb-btn--block sb-btn--lg" data-submit>
                @L["Bərpa linkini göndər"]
            </button>

            <div class="sb-auth__alt">
                @L["Yadına düşdü?"] <a asp-action="Login">@L["Daxil ol"]</a>
            </div>
        </form>
    </div>

    <aside class="sb-auth__panel">
        <div class="sb-auth__panel-top">
            <span class="sb-auth__panel-eyebrow">@L["StyleBazar — təhlükəsizlik"]</span>
            <h2 class="sb-auth__panel-quote">
                "@L["Hesabın"] <em style="color: var(--sb-accent);">@L["təhlükəsizdir."]</em> @L["Yeni parol istənildiyin anda bir kliklə."]"
            </h2>
            <p class="sb-auth__panel-attr">@L["— StyleBazar redaksiyası"]</p>
        </div>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
