@model AccountNotificationsPageViewModel
@using Stylebazar.DAL.Entities.Enums
@{
    ViewData["Title"] = L["Bildirişlər"].Value;

    string EventIcon(LoginEventType t) => t switch
    {
        LoginEventType.SignIn => "M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4 M10 17l5-5-5-5 M15 12H3",
        LoginEventType.SignUp => "M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2 M8.5 7.5a4 4 0 1 1 0 8 4 4 0 0 1 0-8z M20 8v6 M23 11h-6",
        LoginEventType.SignOut => "M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4 M16 17l5-5-5-5 M21 12H9",
        LoginEventType.PasswordChanged => "M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4",
        LoginEventType.PasswordReset => "M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8 M21 3v5h-5 M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16 M8 16H3v5",
        LoginEventType.FailedSignIn => "M12 9v2m0 4h.01 M4.93 4.93l14.14 14.14 M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z",
        LoginEventType.Locked => "M19 11H5a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2z M7 11V7a5 5 0 0 1 10 0v4",
        _ => "M12 8v4 M12 16h.01 M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"
    };

    string EventTone(LoginEventType t) => t switch
    {
        LoginEventType.SignIn => "ok",
        LoginEventType.SignUp => "ok",
        LoginEventType.PasswordChanged => "info",
        LoginEventType.PasswordReset => "info",
        LoginEventType.EmailVerified => "ok",
        LoginEventType.FailedSignIn => "warn",
        LoginEventType.Locked => "danger",
        LoginEventType.SignOut => "muted",
        _ => "muted"
    };

    string EventTitle(LoginEventType t) => t switch
    {
        LoginEventType.SignIn => L["Hesaba giriş"].Value,
        LoginEventType.SignUp => L["Hesab yaradıldı"].Value,
        LoginEventType.SignOut => L["Hesabdan çıxış"].Value,
        LoginEventType.FailedSignIn => L["Uğursuz giriş cəhdi"].Value,
        LoginEventType.PasswordChanged => L["Parol dəyişdirildi"].Value,
        LoginEventType.PasswordReset => L["Parol bərpa edildi"].Value,
        LoginEventType.EmailVerified => L["Email təsdiqləndi"].Value,
        LoginEventType.TwoFactorChallenge => L["İki addımlı doğrulama"].Value,
        LoginEventType.Locked => L["Hesab müvəqqəti bloklandı"].Value,
        _ => L["Hadisə"].Value
    };

    string EventBody(LoginEventDto e) => e.EventType switch
    {
        LoginEventType.SignIn => $"{e.DeviceLabel} {L["cihazından,"].Value} {e.IpAddress ?? "—"}",
        LoginEventType.SignOut => $"{e.DeviceLabel} {L["cihazından"].Value}",
        LoginEventType.FailedSignIn => $"{e.IpAddress ?? "—"} {L["ünvanından yanlış parol"].Value}",
        LoginEventType.Locked => L["5 ardıcıl uğursuz giriş — 15 dəqiqəlik blok"].Value,
        LoginEventType.PasswordReset => L["Email vasitəsilə bərpa linki istifadə olundu"].Value,
        LoginEventType.PasswordChanged => L["Hesabın parolu yeniləndi"].Value,
        _ => e.DeviceLabel ?? string.Empty
    };

    string Relative(DateTime dtUtc)
    {
        var now = DateTime.UtcNow;
        var span = now - dtUtc;
        if (span.TotalMinutes < 1) return L["indicə"].Value;
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes} {L["dəq əvvəl"].Value}";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours} {L["saat əvvəl"].Value}";
        if (span.TotalDays < 2) return L["Dünən"].Value;
        if (span.TotalDays < 7) return $"{(int)span.TotalDays} {L["gün əvvəl"].Value}";
        return dtUtc.ToLocalTime().ToString("dd MMM yyyy", System.Globalization.CultureInfo.CurrentCulture);
    }

    // Group events by day bucket
    DateTime nowUtc = DateTime.UtcNow;
    DateTime todayUtc = nowUtc.Date;
    DateTime yesterdayUtc = todayUtc.AddDays(-1);
    DateTime weekAgoUtc = todayUtc.AddDays(-7);

    string Bucket(DateTime dt) =>
        dt.Date == todayUtc ? L["Bu gün"].Value
        : dt.Date == yesterdayUtc ? L["Dünən"].Value
        : dt.Date > weekAgoUtc ? L["Bu həftə"].Value
        : L["Daha əvvəl"].Value;

    var grouped = Model.Events
        .GroupBy(e => Bucket(e.CreatedDate))
        .Select(g => new { Title = g.Key, Items = g.ToList() })
        .ToList();
}

<section class="sb-acc-layout">
    @await Html.PartialAsync("_AccountSidebar", Model.Profile)

    <main class="sb-acc-main">
        <header class="sb-acc-section-title">
            <h1>@L["Bildirişlər"]</h1>
            <p class="sb-acc-section-title__sub">@L["Son 30 günün hesab aktivliyi"]</p>
        </header>

        @if (!Model.Events.Any())
        {
            <div class="sb-acc-card sb-acc-empty">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                <strong>@L["Hələ bildiriş yoxdur"]</strong>
                <p>@L["Sənə yeni bildiriş gəldikdə burada görünəcək."]</p>
            </div>
        }
        else
        {
            <div class="sb-notif-timeline">
                @foreach (var group in grouped)
                {
                    <div class="sb-notif-group">
                        <h2 class="sb-notif-group__title">@group.Title</h2>
                        <ol class="sb-notif-list">
                            @foreach (var e in group.Items)
                            {
                                <li class="sb-notif-item sb-notif-item--@EventTone(e.EventType)">
                                    <span class="sb-notif-item__dot" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7">
                                            <path d="@EventIcon(e.EventType)" />
                                        </svg>
                                    </span>
                                    <div class="sb-notif-item__body">
                                        <div class="sb-notif-item__title">@EventTitle(e.EventType)</div>
                                        <div class="sb-notif-item__meta">@EventBody(e)</div>
                                    </div>
                                    <time class="sb-notif-item__time" datetime="@e.CreatedDate.ToString("o")">@Relative(e.CreatedDate)</time>
                                </li>
                            }
                        </ol>
                    </div>
                }
            </div>
        }
    </main>
</section>
