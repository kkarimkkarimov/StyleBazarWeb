@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Yeni parol təyin et";
}

<div class="sb-auth">
    <div class="sb-auth__form-wrap">
        <form class="sb-auth__form" asp-action="ResetPassword" method="post" novalidate data-auth-form>
            @Html.AntiForgeryToken()

            <input asp-for="Email" type="hidden" />
            <input asp-for="Token" type="hidden" />

            <h1>Yeni <em>parol.</em></h1>
            <p class="sb-auth__form-sub">@(string.IsNullOrEmpty(Model.Email) ? "Hesabın" : Model.Email) — yeni parolu təyin et və daxil ol.</p>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""]?.Errors.Count > 0)
            {
                <div class="sb-form-summary">
                    @foreach (var err in ViewData.ModelState[""]!.Errors) { @err.ErrorMessage <br /> }
                </div>
            }

            <div class="sb-field">
                <label class="sb-field__label" asp-for="NewPassword">Yeni parol</label>
                <div class="sb-field__input-wrap">
                    <input class="sb-field__input sb-field__input--has-icon @(ViewData.ModelState["NewPassword"]?.Errors.Count > 0 ? "is-error" : "")"
                           asp-for="NewPassword"
                           type="password"
                           placeholder="Minimum 6 simvol"
                           autocomplete="new-password"
                           data-pwd data-pwd-meter />
                    <button type="button" class="sb-field__icon-btn" data-pwd-toggle aria-label="Parolu göstər">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" data-eye>
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" data-eye-off style="display:none">
                            <path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94"/>
                            <path d="M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19"/>
                            <line x1="1" y1="1" x2="23" y2="23"/>
                        </svg>
                    </button>
                </div>
                <div class="sb-pwd-meter" data-meter>
                    <span class="sb-pwd-meter__bar"></span>
                    <span class="sb-pwd-meter__bar"></span>
                    <span class="sb-pwd-meter__bar"></span>
                </div>
                <div class="sb-pwd-meter__label" data-meter-label>Parol gücü</div>
                <span class="sb-field__error" asp-validation-for="NewPassword"></span>
            </div>

            <div class="sb-field">
                <label class="sb-field__label" asp-for="ConfirmPassword">Parolu təkrarla</label>
                <input class="sb-field__input @(ViewData.ModelState["ConfirmPassword"]?.Errors.Count > 0 ? "is-error" : "")"
                       asp-for="ConfirmPassword"
                       type="password"
                       placeholder="••••••••"
                       autocomplete="new-password" />
                <span class="sb-field__error" asp-validation-for="ConfirmPassword"></span>
            </div>

            <button type="submit" class="sb-btn sb-btn--primary sb-btn--block sb-btn--lg" data-submit>
                Parolu yenilə
            </button>

            <div class="sb-auth__alt">
                <a asp-action="Login">Girişə qayıt</a>
            </div>
        </form>
    </div>

    <aside class="sb-auth__panel">
        <div class="sb-auth__panel-top">
            <span class="sb-auth__panel-eyebrow">StyleBazar</span>
            <h2 class="sb-auth__panel-quote">"Güclü parol — <em style="color: var(--sb-accent);">təhlükəsiz hesab.</em>"</h2>
        </div>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
