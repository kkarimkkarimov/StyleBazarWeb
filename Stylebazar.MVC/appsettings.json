{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "LuckyPennySoftware.AutoMapper.License": "Error",
        "Microsoft.AspNetCore.StaticAssets": "Warning",
        "Microsoft.AspNetCore.Watch": "Error",
        "Microsoft.WebTools.BrowserLink": "Error"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/stylebazar-mvc-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": { "Application": "Stylebazar.MVC" }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=StyleBazarDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Encrypt=False"
  },
  "Jwt": {
    "Issuer": "StyleBazar.MVC",
    "Audience": "StyleBazar.Clients",
    "ExpireMinutes": 60
  },
  "Admin": {
    "Email": "admin@stylebazar.local",
    "FullName": "Platform Admin"
  },
  "FileStorage": {
    "MaxFileSizeBytes": 10485760,
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp" ]
  },
  "Observability": {
    "//": "Set OtlpEndpoint (or env Observability__OtlpEndpoint) to a collector to enable OpenTelemetry traces + metrics. Empty = disabled.",
    "OtlpEndpoint": ""
  },
  "Stripe": {
    "//": "TEST acarlari lokal rahatliq ucun buradadir (her muhitde — Development+Production — yuklenir). PRODUCTION ucun: sk_live/pk_live isle, SecretKey+WebhookSecret-i ENV VAR ile ver (Stripe__SecretKey, Stripe__WebhookSecret), ve bu test SecretKey-i buradan sil + Stripe dashboard-dan rotate et.",
    "PublishableKey": "pk_test_51TfOELKH6RMAfE1wmpZ5UykFq633UOfo4Edktpkcvvsv1sAlfknr7clK4HlCFDuq25DsyuwqEpdOE5ZYM2NNBmpx00PZqOhDHp",
    "SecretKey": "sk_test_51TfOELKH6RMAfE1w8GINQfhzhDo0UUMvNV4eewM6wGXueEoi5lrdTNBMjCpwAaFPJ4DrkiVv7RxdbUHQJcd5F83G00Y6bPjNuG",
    "WebhookSecret": "",
    "Currency": "usd"
  }
}

