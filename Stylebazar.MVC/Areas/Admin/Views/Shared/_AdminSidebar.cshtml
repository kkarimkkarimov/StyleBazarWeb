@model string
@{
    string section = Model ?? "Dashboard";
    string Active(string s) => string.Equals(s, section, StringComparison.OrdinalIgnoreCase) ? "is-active" : "";
}
<aside class="sb-admin-sidebar" data-admin-sidebar>
    <header class="sb-admin-sidebar__brand">
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="sb-admin-sidebar__brand-link">
            <span class="sb-admin-sidebar__brand-wordmark">StyleBazar<em>.</em></span>
            <span class="sb-admin-sidebar__brand-sub">Admin Panel</span>
        </a>
    </header>

    <nav class="sb-admin-sidebar__nav" aria-label="Admin naviqasiya">
        <div class="sb-admin-sidebar__group">
            <span class="sb-admin-sidebar__group-title">Ümumi</span>
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="sb-admin-sidebar__link @Active("Dashboard")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>
                <span>Dashboard</span>
            </a>
        </div>

        <div class="sb-admin-sidebar__group">
            <span class="sb-admin-sidebar__group-title">İdarəetmə</span>
            <a asp-area="Admin" asp-controller="User" asp-action="Index" class="sb-admin-sidebar__link @Active("User")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
                <span>İstifadəçilər</span>
            </a>
            <a asp-area="Admin" asp-controller="Store" asp-action="Index" class="sb-admin-sidebar__link @Active("Store")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"><path d="M3 9l1-5h16l1 5"/><path d="M5 9v11h14V9"/><path d="M9 22V14h6v8"/></svg>
                <span>Mağazalar</span>
            </a>
            <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="sb-admin-sidebar__link @Active("Product")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"><path d="M16.5 9.4l-9-5.19"/><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                <span>Məhsullar</span>
            </a>
            <a asp-area="Admin" asp-controller="Category" asp-action="Index" class="sb-admin-sidebar__link @Active("Category")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/></svg>
                <span>Kateqoriyalar</span>
            </a>
            <a asp-area="Admin" asp-controller="Conversation" asp-action="Index" class="sb-admin-sidebar__link @Active("Conversation")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>
                <span>Söhbətlər</span>
            </a>
        </div>

        <div class="sb-admin-sidebar__group">
            <span class="sb-admin-sidebar__group-title">Kontent</span>
            <a asp-area="Admin" asp-controller="HeroBanner" asp-action="Index" class="sb-admin-sidebar__link @Active("HeroBanner")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8.5" cy="10.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                <span>Hero Banner-lər</span>
            </a>
            <a asp-area="Admin" asp-controller="Story" asp-action="Index" class="sb-admin-sidebar__link @Active("Story")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/></svg>
                <span>Hekayələr</span>
            </a>
            <a asp-area="Admin" asp-controller="Review" asp-action="Index" class="sb-admin-sidebar__link @Active("Review")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <span>Rəylər</span>
            </a>
        </div>

        <div class="sb-admin-sidebar__group">
            <span class="sb-admin-sidebar__group-title">Əlaqə</span>
            <a asp-area="Admin" asp-controller="ContactMessage" asp-action="Index" class="sb-admin-sidebar__link @Active("ContactMessage")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
                <span>Mesajlar</span>
            </a>
            <a asp-area="Admin" asp-controller="Newsletter" asp-action="Index" class="sb-admin-sidebar__link @Active("Newsletter")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                <span>Newsletter</span>
            </a>
        </div>

        <div class="sb-admin-sidebar__group">
            <span class="sb-admin-sidebar__group-title">Hesab</span>
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="sb-admin-sidebar__logout-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="sb-admin-sidebar__link sb-admin-sidebar__link--danger">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    <span>Çıxış</span>
                </button>
            </form>
        </div>
    </nav>
</aside>
