@model AdminStoresPageViewModel
@{
    ViewData["Title"] = L["Mağazalar"].Value;
    ViewData["PageTitle"] = L["Mağazalar"].Value;
}

<form method="get" class="sb-admin-filter-bar">
    <input type="text" name="Search" value="@Model.Search" placeholder="@L["Mağaza adı axtar..."]" class="sb-admin-search" />
    <select name="IsActive" class="sb-admin-select">
        <option value="" selected="@(Model.IsActive == null)">@L["Bütün statuslar"]</option>
        <option value="true" selected="@(Model.IsActive == true)">@L["Aktiv"]</option>
        <option value="false" selected="@(Model.IsActive == false)">@L["Deaktiv"]</option>
    </select>
    <button type="submit" class="sb-admin-btn sb-admin-btn--ghost">@L["Filtr"]</button>
</form>

@* Bulk-action form is rendered EMPTY here as a sibling of the table — the checkboxes
   inside the table associate to it via form="adm-store-bulk". Per-row icon-button
   forms then live freely inside the table cells with no nesting (HTML5 forbids
   nested <form> — browsers silently flatten and break the inner submits). *@
<form id="adm-store-bulk" asp-area="Admin" asp-controller="Store" asp-action="BulkAction" method="post" data-admin-bulk-form>
    @Html.AntiForgeryToken()
    <div class="sb-admin-bulk-bar" data-admin-bulk-bar hidden>
        <span><strong data-admin-bulk-count>0</strong> @L["seçildi"]</span>
        <button type="submit" name="action" value="toggle" class="sb-admin-btn sb-admin-btn--warn" data-confirm="@L["Statusu dəyişməyə əminsən?"]">@L["Status dəyiş"]</button>
        <button type="submit" name="action" value="delete" class="sb-admin-btn sb-admin-btn--danger" data-confirm="@L["Silməyə əminsən? Yalnız məhsulu olmayan mağazaları silmək olar."]">@L["Sil"]</button>
    </div>
</form>

<div class="sb-admin-card sb-admin-table-card">
    @if (!Model.Stores.Items.Any())
    {
        <div class="sb-admin-empty"><strong>@L["Mağaza tapılmadı"]</strong></div>
    }
    else
    {
        <table class="sb-admin-table">
            <thead>
                <tr>
                    <th class="sb-admin-table__check"><input type="checkbox" data-admin-bulk-toggle form="adm-store-bulk" /></th>
                    <th>@L["Mağaza"]</th>
                    <th>Slug</th>
                    <th>@L["Stat.Products"]</th>
                    <th>Status</th>
                    <th>@L["Yaradılıb"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Stores.Items)
                {
                    <tr>
                        <td><input type="checkbox" name="ids" value="@s.Id" data-admin-bulk-item form="adm-store-bulk" /></td>
                        <td>
                            <div class="sb-admin-user-cell">
                                <span class="sb-admin-avatar">
                                    @if (!string.IsNullOrEmpty(s.ProfileImageUrl)) { <img src="@s.ProfileImageUrl" alt="" /> }
                                    else { <span>@(s.Name.Length > 0 ? s.Name[0].ToString().ToUpper() : "?")</span> }
                                </span>
                                <strong>@s.Name</strong>
                            </div>
                        </td>
                        <td><code>@s.Slug</code></td>
                        <td>@s.ProductCount</td>
                        <td>@(s.IsActive ? Html.Raw($"<span class='sb-admin-chip sb-admin-chip--ok'>{L["Aktiv"].Value}</span>") : Html.Raw($"<span class='sb-admin-chip sb-admin-chip--danger'>{L["Deaktiv"].Value}</span>"))</td>
                        <td><span class="sb-admin-date">@s.CreatedDate.ToLocalTime().ToString("dd.MM.yyyy")</span></td>
                        <td class="sb-admin-table__actions">
                            <a asp-area="" asp-controller="Store" asp-action="Detail" asp-route-slug="@s.Slug" target="_blank" class="sb-admin-icon-btn" title="@L["Saytda bax"]">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                            </a>
                            <form asp-area="Admin" asp-controller="Store" asp-action="ToggleActive" method="post" class="sb-admin-inline-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@s.Id" />
                                <button type="submit" class="sb-admin-icon-btn" title="@(s.IsActive ? L["Deaktiv et"].Value : L["Aktivləşdir"].Value)">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"><polyline points="22 4 12 14.01 9 11.01"/></svg>
                                </button>
                            </form>
                            <form asp-area="Admin" asp-controller="Store" asp-action="Delete" method="post" class="sb-admin-inline-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@s.Id" />
                                <button type="submit" class="sb-admin-icon-btn sb-admin-icon-btn--danger" data-confirm="@L["Silməyə əminsən?"]" title="@L["Sil"]">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/></svg>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@await Html.PartialAsync("_AdminPagination", new Tuple<int,int,int>(Model.Stores.Index + 1, Model.Stores.Pages, Model.Stores.Count))
