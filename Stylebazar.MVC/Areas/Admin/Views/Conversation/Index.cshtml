@model AdminConversationsPageViewModel
@{
    ViewData["Title"] = L["Söhbətlər"].Value;
    ViewData["PageTitle"] = L["Söhbətlər"].Value;
}

<div class="sb-admin-card sb-admin-table-card">
    @if (!Model.Conversations.Items.Any())
    {
        <div class="sb-admin-empty">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg>
            <strong>@L["Hələ söhbət yoxdur"]</strong>
            <span>@L["İstifadəçilər mesajlaşdıqca burada görünəcək."]</span>
        </div>
    }
    else
    {
        <table class="sb-admin-table">
            <thead>
                <tr>
                    <th>@L["İştirakçılar"]</th>
                    <th>@L["Mesaj sayı"]</th>
                    <th>@L["Son mesaj"]</th>
                    <th>@L["Son aktivlik"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Conversations.Items)
                {
                    <tr>
                        <td>
                            <div class="sb-admin-convo-peers">
                                <span><strong>@c.User1FullName</strong> <em class="sb-admin-chip sb-admin-chip--@c.User1Role.ToLower()">@c.User1Role</em></span>
                                <span class="sb-admin-convo-peers__arrow">↔</span>
                                <span><strong>@c.User2FullName</strong> <em class="sb-admin-chip sb-admin-chip--@c.User2Role.ToLower()">@c.User2Role</em></span>
                            </div>
                        </td>
                        <td>@c.MessageCount</td>
                        <td><span class="sb-admin-clamp-2">@(string.IsNullOrEmpty(c.LastMessagePreview) ? "—" : c.LastMessagePreview)</span></td>
                        <td><span class="sb-admin-date">@c.LastMessageAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span></td>
                        <td class="sb-admin-table__actions">
                            <a asp-area="Admin" asp-controller="Conversation" asp-action="Detail" asp-route-id="@c.Id" class="sb-admin-icon-btn" title="@L["Aç"]">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@await Html.PartialAsync("_AdminPagination", new Tuple<int,int,int>(Model.Conversations.Index + 1, Model.Conversations.Pages, Model.Conversations.Count))
