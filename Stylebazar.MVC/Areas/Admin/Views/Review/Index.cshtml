@model AdminReviewsPageViewModel
@{
    ViewData["Title"] = L["Rəylər"].Value;
    ViewData["PageTitle"] = L["Rəylər"].Value;
}

<form method="get" class="sb-admin-filter-bar">
    <input type="text" name="search" value="@Model.Search" placeholder="@L["Şərhdə axtar..."]" class="sb-admin-search" />
    <select name="maxRating" class="sb-admin-select">
        <option value="">@L["Bütün ulduzlar"]</option>
        @for (int i = 1; i <= 5; i++)
        {
            int v = i;
            <option value="@v" selected="@(Model.RatingFilter == v)">≤ @v @L["ulduz"]</option>
        }
    </select>
    <button type="submit" class="sb-admin-btn sb-admin-btn--ghost">@L["Filtr"]</button>
</form>

@* Bulk form: empty sibling, table checkboxes attach via form="adm-review-bulk". *@
<form id="adm-review-bulk" asp-area="Admin" asp-controller="Review" asp-action="BulkDelete" method="post" data-admin-bulk-form>
    @Html.AntiForgeryToken()
    <div class="sb-admin-bulk-bar" data-admin-bulk-bar hidden>
        <span><strong data-admin-bulk-count>0</strong> @L["seçildi"]</span>
        <button type="submit" class="sb-admin-btn sb-admin-btn--danger" data-confirm="@L["Seçilmiş rəyləri silməyə əminsən?"]">@L["Sil"]</button>
    </div>
</form>

<div class="sb-admin-card sb-admin-table-card">
    @if (!Model.Reviews.Any())
    {
        <div class="sb-admin-empty"><strong>@L["Rəy yoxdur"]</strong></div>
    }
    else
    {
        <table class="sb-admin-table">
            <thead>
                <tr>
                    <th class="sb-admin-table__check"><input type="checkbox" data-admin-bulk-toggle form="adm-review-bulk" /></th>
                    <th>@L["Reytinq"]</th>
                    <th>@L["Şərh"]</th>
                    <th>@L["Stat.Products"]</th>
                    <th>@L["İstifadəçi"]</th>
                    <th>@L["Tarix"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Reviews)
                {
                    var rev = r.Review;
                    <tr>
                        <td><input type="checkbox" name="ids" value="@rev.Id" data-admin-bulk-item form="adm-review-bulk" /></td>
                        <td>
                            <div class="sb-admin-stars">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    bool on = i <= rev.Rating;
                                    <svg class="@(on ? "is-on" : "")" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                                }
                            </div>
                        </td>
                        <td><span class="sb-admin-clamp-2">@(string.IsNullOrEmpty(rev.Comment) ? "—" : rev.Comment)</span></td>
                        <td>
                            <a asp-area="" asp-controller="Shop" asp-action="Detail" asp-route-id="@r.ProductId" target="_blank">@r.ProductName</a>
                        </td>
                        <td>@rev.UserFullName</td>
                        <td><span class="sb-admin-date">@rev.CreatedDate.ToLocalTime().ToString("dd.MM.yyyy")</span></td>
                        <td class="sb-admin-table__actions">
                            <form asp-area="Admin" asp-controller="Review" asp-action="Delete" method="post" class="sb-admin-inline-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@rev.Id" />
                                <button type="submit" class="sb-admin-icon-btn sb-admin-icon-btn--danger" data-confirm="@L["Silməyə əminsən?"]" title="@L["Sil"]">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/></svg>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
