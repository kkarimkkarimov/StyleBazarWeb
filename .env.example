# StyleBazar production secrets — copy this file to ".env" and fill in the values.
#   cp .env.example .env   then edit .env
# NEVER commit the real .env (it is git-ignored). Only this example is tracked.

# Your domain (must already point to the server's IP via an A record).
DOMAIN=stylebazar.az

# SQL Server "sa" password. Must be strong: 12+ chars with UPPER, lower, digit
# and a symbol (SQL Server rejects weak passwords).
SA_PASSWORD=CHANGE_ME_Strong#Db1234

# JWT signing key — at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_KEY=CHANGE_ME_base64_48_byte_random_string

# First admin login password (used once to seed admin@stylebazar.local).
# Change it from inside the app after the first login.
ADMIN_PASSWORD=CHANGE_ME_Strong#Admin1234

# OPTIONAL — SMTP/SendGrid API key for password-reset emails. Leave blank to
# deploy without email (you can add it later and restart). Configure the SMTP
# host/port/from-address in Stylebazar.MVC/appsettings.Production.json.
EMAIL_PASSWORD=
