{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "LuckyPennySoftware.AutoMapper.License": "Error",
        "Microsoft.AspNetCore.StaticAssets": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/stylebazar-api-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": { "Application": "Stylebazar.API" }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=StyleBazarDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Encrypt=False"
  },
  "Jwt": {
    "Issuer": "StyleBazar.API",
    "Audience": "StyleBazar.Clients",
    "ExpireMinutes": 60
  },
  "Admin": {
    "Email": "admin@stylebazar.local",
    "FullName": "Platform Admin"
  },
  "Cors": {
    "//": "Cross-origin browser clients. Dev: empty → any localhost origin reflected. Prod: explicit https origins only.",
    "Origins": []
  },
  "Observability": {
    "//": "Set OtlpEndpoint (or env Observability__OtlpEndpoint) to a collector to enable OpenTelemetry traces + metrics. Empty = disabled.",
    "OtlpEndpoint": ""
  },
  "Stripe": {
    "PublishableKey": "pk_test_51TfOECGkdYDLYUaIdkHMhsmKAd8IZOdFrS0tR6f2TgZHtCmdMKbVTlJKww1ClAvKkQw2wbV4s7doCbtbjUPOAM6N00iDyHkwUi",
    "SecretKey": "sk_test_51TfOECGkdYDLYUaI2emBCZgKwN5YRilnuvEaG67DDT0G82PMAxB5zvBMm9MJbOZmWIuvsWRqsWJTRZYlO2FXk4LT00eoLroMpI"
  }
}

