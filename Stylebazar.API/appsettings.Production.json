{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "api.stylebazar.az",
  "ConnectionStrings": {
    "//": "Override via env var: ConnectionStrings__DefaultConnection",
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "StyleBazar.API",
    "Audience": "StyleBazar.Clients",
    "//Key": "REQUIRED — set via env var Jwt__Key (≥32 chars, rotate quarterly)",
    "Key": "",
    "ExpireMinutes": 60
  },
  "Admin": {
    "//": "Set Admin__Password via env var. Email + FullName can stay here.",
    "Email": "",
    "FullName": "",
    "Password": ""
  },
  "Cors": {
    "//": "Browser origins allowed to call the API. Add the real front-end domains.",
    "Origins": [ "https://stylebazar.az", "https://www.stylebazar.az" ]
  }
}
